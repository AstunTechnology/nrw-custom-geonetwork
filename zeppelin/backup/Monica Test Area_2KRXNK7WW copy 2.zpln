      "jobName": "paragraph_1772622629232_1200754235",
      "id": "paragraph_1772622629232_1200754235",
      "dateCreated": "2026-03-04 11:10:29.232",
      "status": "READY"
    },
    {
      "title": "1. Report on Keywords All as anchor",
      "text": "-- This selects from parts of the system that are not within the XML of the individual records\n--THis report simply outputs a lists of all the keywords - assuming they are all anchor tags (which they are not) - ONLY gemet keywords are anchors and some MEDIN keyswords.  All other keywords are character strings\n-- Working copy build to help me expand to full report on all keywordss\n\nSELECT\n  mx.uuid AS \"NRW File identifier\",\n\n-- The following code selects elements out of the XML Data column i.e from the records themselves\n\n  -- Title\n  array_to_string(\n    xpath(\u0027/gmd:MD_Metadata/gmd:identificationInfo/gmd:MD_DataIdentification/gmd:citation/gmd:CI_Citation/gmd:title/gco:CharacterString/text()\u0027::text, \n          mx.data_xml, \n          \u0027{{gco,http://www.isotc211.org/2005/gco},\n            {gmd,http://www.isotc211.org/2005/gmd}}\u0027::text[]), \n    \u0027-\u0027::text\n  ) AS \"Title\",\n\n \n\n  -- INSPIRE Theme Keywords under descriptiveKeywords\n array_to_string(\n    xpath(\n      \u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[gmd:type/gmd:MD_KeywordTypeCode[@codeListValue\u003d\"theme\"]\n         and\n         gmd:thesaurusName//gmx:Anchor[text()\u003d\"GEMET - INSPIRE themes, version 1.0\"]]/gmd:keyword/gmx:Anchor/text()\u0027::text,\n      mx.data_xml,\n      \u0027{{gmd,http://www.isotc211.org/2005/gmd},\n        {gmx,http://www.isotc211.org/2005/gmx},\n        {xlink,http://www.w3.org/1999/xlink}}\u0027::text[]\n    ),\n    \u0027, \u0027::text\n  ) AS \"GEMET Keywords\",\n  \n   -- NRW Keywords\n   array_to_string(\n    xpath(\n      \u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[gmd:type/gmd:MD_KeywordTypeCode[@codeListValue\u003d\"theme\"]\n         and\n         gmd:thesaurusName//gmx:Anchor[text()\u003d\"NRW Thesauru\"]]/gmd:keyword/gmx:Anchor/text()\u0027::text,\n      mx.data_xml,\n      \u0027{{gmd,http://www.isotc211.org/2005/gmd},\n        {gmx,http://www.isotc211.org/2005/gmx},\n        {xlink,http://www.w3.org/1999/xlink}}\u0027::text[]\n    ),\n    \u0027, \u0027::text\n  ) AS \"NRW Keywords\",\n\n -- MEDIN / SeaDataNet Keywords\n  array_to_string(\n    xpath(\n      \u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[gmd:type/gmd:MD_KeywordTypeCode[@codeListValue\u003d\"theme\"]\n         and\n         gmd:thesaurusName//gmx:Anchor[text()\u003d\"SeaDataNet Parameter Discovery Vocabulary\"]]/gmd:keyword/gmx:Anchor/text()\u0027::text,\n      mx.data_xml,\n      \u0027{{gmd,http://www.isotc211.org/2005/gmd},\n        {gmx,http://www.isotc211.org/2005/gmx},\n        {xlink,http://www.w3.org/1999/xlink}}\u0027::text[]\n    ),\n    \u0027, \u0027::text\n  ) AS \"MEDIN Keywords\",\n  \n  -- SMNR Keywords\n  array_to_string(\n    xpath(\n      \u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[gmd:type/gmd:MD_KeywordTypeCode[@codeListValue\u003d\"theme\"]\n         and\n         gmd:thesaurusName//gmx:Anchor[text()\u003d\"NRW SMNR Keywords\"]]/gmd:keyword/gmx:Anchor/text()\u0027::text,\n      mx.data_xml,\n      \u0027{{gmd,http://www.isotc211.org/2005/gmd},\n        {gmx,http://www.isotc211.org/2005/gmx},\n        {xlink,http://www.w3.org/1999/xlink}}\u0027::text[]\n    ),\n    \u0027, \u0027::text\n  ) AS \"SMNR Keywords\",\n\n-- IPSV Keywords\n array_to_string(\n    xpath(\n      \u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[gmd:type/gmd:MD_KeywordTypeCode[@codeListValue\u003d\"theme\"]\n         and\n         gmd:thesaurusName//gmx:Anchor[text()\u003d\"IPSV Subjects List\"]]/gmd:keyword/gmx:Anchor/text()\u0027::text,\n      mx.data_xml,\n      \u0027{{gmd,http://www.isotc211.org/2005/gmd},\n        {gmx,http://www.isotc211.org/2005/gmx},\n        {xlink,http://www.w3.org/1999/xlink}}\u0027::text[]\n    ),\n    \u0027, \u0027::text\n  ) AS \"IPSV Keywords\", \n\n-- Added in information aboutthe records status\n-- identify if they already went through validaton process  \n  (CASE\n        WHEN EXISTS (\n            SELECT 1\n            FROM validation\n            WHERE metadataid \u003d mx.id AND required \u003d \u0027true\u0027 AND failed !\u003d 0\n        ) THEN \u0027Invalid\u0027\n        WHEN EXISTS (\n            SELECT 1\n            FROM validation\n            WHERE metadataid \u003d mx.id AND required \u003d \u0027true\u0027 AND failed \u003d 0\n        ) THEN \u0027Valid\u0027\n        ELSE \u0027Unknown\u0027\n    END\n  ) AS \"Validation Status\",\n\n--  to identify if they are relevant to MEDIN or data.gov as will be prioroty to fix before harvest \n  (CASE\n        WHEN EXISTS (SELECT 1 FROM operationallowed oa WHERE oa.metadataid \u003d mx.id AND oa.groupid \u003d 102 AND oa.operationid \u003d 0) AND EXISTS (SELECT 1 FROM operationallowed oa2 WHERE oa2.metadataid \u003d mx.id AND oa2.groupid \u003d 103 AND oa2.operationid \u003d 0) THEN \u0027GEMINI \u0026 MEDIN\u0027\n        WHEN EXISTS (SELECT 1 FROM operationallowed oa WHERE oa.metadataid \u003d mx.id AND oa.groupid \u003d 102 AND oa.operationid \u003d 0) THEN \u0027GEMINI\u0027\n        WHEN EXISTS (SELECT 1 FROM operationallowed oa WHERE oa.metadataid \u003d mx.id AND oa.groupid \u003d 103 AND oa.operationid \u003d 0) THEN \u0027MEDIN\u0027\n        ELSE \u0027-\u0027\n    END \n  ) AS \"Groups Available in (GEMINI / MEDIN)\",\n\n-- Add in section as to whether in public view\n(\n    CASE WHEN EXISTS (\n      SELECT \n        1 \n      FROM \n        operationallowed oa \n      WHERE \n        oa.metadataid \u003d mx.id \n        AND oa.groupid \u003d 1 \n        AND oa.operationid \u003d 0\n    ) THEN \u0027Public record\u0027 ELSE \u0027Private record\u0027 END\n  ) AS \"Record in Public view\" \n\nFROM custom.metadata_xml mx\nWHERE (mx.istemplate \u003d \u0027n\u0027 OR mx.istemplate \u003d \u0027y\u0027)\n\n--enable this if you want  to select a specific file\n--AND mx.uuid \u003d \u0027${NRW File identifier}\u0027 \n\nLIMIT 4000;",
      "user": "anonymous",
      "dateUpdated": "2026-03-04 16:57:44.711",
      "progress": 0,
