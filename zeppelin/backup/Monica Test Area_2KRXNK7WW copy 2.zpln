      "jobName": "paragraph_1761907809859_1305616773",
      "id": "paragraph_1761907809859_1305616773",
      "dateCreated": "2025-10-31 10:50:09.859",
      "dateStarted": "2026-02-26 11:10:37.991",
      "dateFinished": "2026-02-26 11:10:49.337",
      "status": "FINISHED"
    },
    {
      "title": "Elena - Report on all keywords",
      "text": "-- Working copy as have copied a final version of this repor tto the NRW reporting area.\n\n-- -- Elena provided this report under call-off 25/02/2026\n-- The aim of the report is to provide a comprehensive list of all records and the status of the keyword column\n-- 1. For each of the keywords types; GEMET, MEDIN/SeaDataNet, NRW Keyworrds, IPSV keywords, SMNR Keywords the aim is that Keywod column would be populated with an valid keyword or the word \"Not Present\" (meaning that the XML block is not present and the XML is valid). IF the Keyword if populated with !! Missing (nilReason) !! this means that the Keyword category was added to the record BUT Not filled out, therefore the XML block is present but missing its keyword and will be invalid when harvested by MEDIN or other portals\n-- 2. For each Keyword, the Keyword Type should be \"Anchor\", \"character\" or \"-\". All GEMET keywords should be anchors, All MEDIN keywords should be anchors, all NRW Keywords, IPSV keywords and SMNR keywords should be character. Records where the keyword is not added should be \"-\". IF the type is listed as !! No child element !! This is an indication of an invalid XML block as decsribed in part 1\n-- Once the validation is completed there will be no \"!! Missing (nilReason) !!\"\" or \"!! No child element !!\" returns in the report\n\nSELECT\n mx.uuid AS \"NRW File identifier\",\n mx.createdate AS \"Date Created\",\n ms.changedate AS \"Date Last Edited\", \n u.name || \u0027 \u0027 || u.surname AS \"Last Editor Name\",\n\n --- Title ---\n array_to_string(\n xpath(\u0027/gmd:MD_Metadata/gmd:identificationInfo/gmd:MD_DataIdentification/gmd:citation/gmd:CI_Citation/gmd:title/gco:CharacterString/text()\u0027::text, \n mx.data_xml, \n \u0027{{gco,http://www.isotc211.org/2005/gco},{gmd,http://www.isotc211.org/2005/gmd}}\u0027::text[]), \n \u0027-\u0027::text\n ) AS \"Title\",\n\n --- 1. MEDIN / SeaDataNet audit ---\n CASE \n WHEN NOT xpath_exists(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[contains(., \"SeaDataNet\")]\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd}}\u0027::text[]) THEN \u0027Not Present\u0027\n WHEN xpath_exists(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[contains(., \"SeaDataNet\")]/gmd:keyword[@gco:nilReason]\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gco,http://www.isotc211.org/2005/gco}}\u0027::text[]) THEN \u0027!! Missing (nilReason) !!\u0027\n ELSE btrim(array_to_string(xpath(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[contains(., \"SeaDataNet\")]/gmd:keyword/*[normalize-space(text())]/text()\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gco,http://www.isotc211.org/2005/gco},{gmx,http://www.isotc211.org/2005/gmx}}\u0027::text[]), \u0027, \u0027), \u0027, \u0027)\n END AS \"MEDIN Keywords\",\n CASE\n WHEN xpath_exists(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[contains(., \"SeaDataNet\")]/gmd:keyword/gmx:Anchor\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gmx,http://www.isotc211.org/2005/gmx}}\u0027::text[]) THEN \u0027Anchor\u0027\n WHEN xpath_exists(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[contains(., \"SeaDataNet\")]/gmd:keyword/gco:CharacterString\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gco,http://www.isotc211.org/2005/gco}}\u0027::text[]) THEN \u0027CharacterString\u0027\n WHEN xpath_exists(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[contains(., \"SeaDataNet\")]/gmd:keyword[@gco:nilReason]\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gco,http://www.isotc211.org/2005/gco}}\u0027::text[]) THEN \u0027!! No child element !!\u0027\n WHEN xpath_exists(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[contains(., \"SeaDataNet\")]/gmd:keyword/gmx:Anchor\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gmx,http://www.isotc211.org/2005/gmx}}\u0027::text[]) \n AND xpath_exists(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[contains(., \"SeaDataNet\")]/gmd:keyword/gco:CharacterString\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gco,http://www.isotc211.org/2005/gco}}\u0027::text[]) THEN \u0027!! CONFLICT: Mixed tags !!\u0027\n ELSE \u0027-\u0027\n END AS \"MEDIN Type\",\n\n --- 2. GEMET / INSPIRE Themes audit ---\n CASE \n WHEN NOT xpath_exists(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[contains(., \"GEMET - INSPIRE themes\")]\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd}}\u0027::text[]) THEN \u0027Not Present\u0027\n WHEN xpath_exists(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[contains(., \"GEMET\")]/gmd:keyword[@gco:nilReason]\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gco,http://www.isotc211.org/2005/gco}}\u0027::text[]) THEN \u0027!! Missing (nilReason) !!\u0027\n ELSE btrim(array_to_string(xpath(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[contains(., \"GEMET\")]/gmd:keyword/*[normalize-space(text())]/text()\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gmx,http://www.isotc211.org/2005/gmx}}\u0027::text[]), \u0027, \u0027), \u0027, \u0027)\n END AS \"GEMET Keywords\",\n CASE\n WHEN xpath_exists(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[contains(., \"GEMET\")]/gmd:keyword/gmx:Anchor\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gmx,http://www.isotc211.org/2005/gmx}}\u0027::text[]) THEN \u0027Anchor\u0027\n WHEN xpath_exists(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[contains(., \"GEMET\")]/gmd:keyword/gco:CharacterString\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gco,http://www.isotc211.org/2005/gco}}\u0027::text[]) THEN \u0027!! CharacterString !!\u0027\n WHEN xpath_exists(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[contains(., \"GEMET\")]/gmd:keyword[@gco:nilReason]\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gco,http://www.isotc211.org/2005/gco}}\u0027::text[]) THEN \u0027!! No child element !!\u0027\n WHEN xpath_exists(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[contains(., \"GEMET\")]/gmd:keyword/gmx:Anchor\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gmx,http://www.isotc211.org/2005/gmx}}\u0027::text[]) \n AND xpath_exists(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[contains(., \"GEMET\")]/gmd:keyword/gco:CharacterString\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gco,http://www.isotc211.org/2005/gco}}\u0027::text[]) THEN \u0027!! CONFLICT: Mixed tags !!\u0027\n ELSE \u0027-\u0027\n END AS \"GEMET Type\",\n\n --- 3. NRW Thesaurus audit ---\n CASE \n WHEN NOT xpath_exists(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[contains(., \"NRW Thesaurus\")]\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd}}\u0027::text[]) THEN \u0027Not Present\u0027\n WHEN xpath_exists(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[contains(., \"NRW Thesaurus\")]/gmd:keyword[@gco:nilReason]\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gco,http://www.isotc211.org/2005/gco}}\u0027::text[]) THEN \u0027!! Missing (nilReason) !!\u0027\n ELSE btrim(array_to_string(xpath(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[contains(., \"NRW Thesaurus\")]/gmd:keyword/*[normalize-space(text())]/text()\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gco,http://www.isotc211.org/2005/gco},{gmx,http://www.isotc211.org/2005/gmx}}\u0027::text[]), \u0027, \u0027), \u0027, \u0027)\n END AS \"NRW Keywords\",\n CASE\n WHEN xpath_exists(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[contains(., \"NRW Thesaurus\")]/gmd:keyword/gmx:Anchor\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gmx,http://www.isotc211.org/2005/gmx}}\u0027::text[]) THEN \u0027Anchor\u0027\n WHEN xpath_exists(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[contains(., \"NRW Thesaurus\")]/gmd:keyword/gco:CharacterString\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gco,http://www.isotc211.org/2005/gco}}\u0027::text[]) THEN \u0027CharacterString\u0027\n WHEN xpath_exists(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[contains(., \"NRW Thesaurus\")]/gmd:keyword[@gco:nilReason]\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gco,http://www.isotc211.org/2005/gco}}\u0027::text[]) THEN \u0027!! No child element !!\u0027\n WHEN xpath_exists(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[contains(., \"NRW Thesaurus\")]/gmd:keyword/gmx:Anchor\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gmx,http://www.isotc211.org/2005/gmx}}\u0027::text[]) \n AND xpath_exists(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[contains(., \"NRW Thesaurus\")]/gmd:keyword/gco:CharacterString\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gco,http://www.isotc211.org/2005/gco}}\u0027::text[]) THEN \u0027!! CONFLICT: Mixed tags !!\u0027\n ELSE \u0027-\u0027\n END AS \"NRW Type\",\n\n --- 4. IPSV subjects audit ---\n CASE \n WHEN NOT xpath_exists(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[contains(., \"Integrated Public Sector Vocabulary\")]\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd}}\u0027::text[]) THEN \u0027Not Present\u0027\n WHEN xpath_exists(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[contains(., \"Integrated Public Sector Vocabulary\")]/gmd:keyword[@gco:nilReason]\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gco,http://www.isotc211.org/2005/gco}}\u0027::text[]) THEN \u0027!! Missing (nilReason) !!\u0027\n ELSE btrim(array_to_string(xpath(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[contains(., \"Integrated Public Sector Vocabulary\")]/gmd:keyword/*[normalize-space(text())]/text()\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gco,http://www.isotc211.org/2005/gco},{gmx,http://www.isotc211.org/2005/gmx}}\u0027::text[]), \u0027, \u0027), \u0027, \u0027)\n END AS \"IPSV Keywords\",\n CASE\n WHEN xpath_exists(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[contains(., \"Integrated Public Sector Vocabulary\")]/gmd:keyword/gmx:Anchor\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gmx,http://www.isotc211.org/2005/gmx}}\u0027::text[]) THEN \u0027Anchor\u0027\n WHEN xpath_exists(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[contains(., \"Integrated Public Sector Vocabulary\")]/gmd:keyword/gco:CharacterString\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gco,http://www.isotc211.org/2005/gco}}\u0027::text[]) THEN \u0027CharacterString\u0027\n WHEN xpath_exists(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[contains(., \"Integrated Public Sector Vocabulary\")]/gmd:keyword[@gco:nilReason]\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gco,http://www.isotc211.org/2005/gco}}\u0027::text[]) THEN \u0027!! No child element !!\u0027\n WHEN xpath_exists(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[contains(., \"Integrated Public Sector Vocabulary\")]/gmd:keyword/gmx:Anchor\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gmx,http://www.isotc211.org/2005/gmx}}\u0027::text[]) \n AND xpath_exists(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[contains(., \"Integrated Public Sector Vocabulary\")]/gmd:keyword/gco:CharacterString\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gco,http://www.isotc211.org/2005/gco}}\u0027::text[]) THEN \u0027!! CONFLICT: Mixed tags !!\u0027\n ELSE \u0027-\u0027\n END AS \"IPSV Type\",\n\n --- 5. SMNR keyword audit ---\n CASE \n WHEN NOT xpath_exists(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[contains(., \"NRW SMNR Vocabulary\")]\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd}}\u0027::text[]) THEN \u0027Not Present\u0027\n WHEN xpath_exists(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[contains(., \"NRW SMNR Vocabulary\")]/gmd:keyword[@gco:nilReason]\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gco,http://www.isotc211.org/2005/gco}}\u0027::text[]) THEN \u0027!! Missing (nilReason) !!\u0027\n ELSE btrim(array_to_string(xpath(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[contains(., \"NRW SMNR Vocabulary\")]/gmd:keyword/*[normalize-space(text())]/text()\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gco,http://www.isotc211.org/2005/gco},{gmx,http://www.isotc211.org/2005/gmx}}\u0027::text[]), \u0027, \u0027), \u0027, \u0027)\n END AS \"SMNR Keywords\",\n CASE\n WHEN xpath_exists(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[contains(., \"NRW SMNR Vocabulary\")]/gmd:keyword/gmx:Anchor\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gmx,http://www.isotc211.org/2005/gmx}}\u0027::text[]) THEN \u0027Anchor\u0027\n WHEN xpath_exists(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[contains(., \"NRW SMNR Vocabulary\")]/gmd:keyword/gco:CharacterString\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gco,http://www.isotc211.org/2005/gco}}\u0027::text[]) THEN \u0027CharacterString\u0027\n WHEN xpath_exists(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[contains(., \"NRW SMNR Vocabulary\")]/gmd:keyword[@gco:nilReason]\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gco,http://www.isotc211.org/2005/gco}}\u0027::text[]) THEN \u0027!! No child element !!\u0027\n WHEN xpath_exists(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[contains(., \"NRW SMNR Vocabulary\")]/gmd:keyword/gmx:Anchor\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gmx,http://www.isotc211.org/2005/gmx}}\u0027::text[]) \n AND xpath_exists(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[contains(., \"NRW SMNR Vocabulary\")]/gmd:keyword/gco:CharacterString\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gco,http://www.isotc211.org/2005/gco}}\u0027::text[]) THEN \u0027!! CONFLICT: Mixed tags !!\u0027\n ELSE \u0027-\u0027\n END AS \"SMNR Type\",\n\n ---- Other info ----\n\n -- to identify if they already went through validaton process \n (CASE\n WHEN EXISTS (\n SELECT 1\n FROM validation\n WHERE metadataid \u003d mx.id AND required \u003d \u0027true\u0027 AND failed !\u003d 0\n ) THEN \u0027Invalid\u0027\n WHEN EXISTS (\n SELECT 1\n FROM validation\n WHERE metadataid \u003d mx.id AND required \u003d \u0027true\u0027 AND failed \u003d 0\n ) THEN \u0027Valid\n ELSE \u0027Unknown\u0027\n END\n ) AS \"Validation Status\",\n\n -- to identify if they are relevant to MEDIN or data.gov as will be prioroty to fix before harvest \n (CASE\n WHEN EXISTS (SELECT 1 FROM operationallowed oa WHERE oa.metadataid \u003d mx.id AND oa.groupid \u003d 102 AND oa.operationid \u003d 0) AND EXISTS (SELECT 1 FROM operationallowed oa2 WHERE oa2.metadataid \u003d mx.id AND oa2.groupid \u003d 103 AND oa2.operationid \u003d 0) THEN \u0027GEMINI \u0026 MEDIN\u0027\n WHEN EXISTS (SELECT 1 FROM operationallowed oa WHERE oa.metadataid \u003d mx.id AND oa.groupid \u003d 102 AND oa.operationid \u003d 0) THEN \u0027GEMINI\u0027\n WHEN EXISTS (SELECT 1 FROM operationallowed oa WHERE oa.metadataid \u003d mx.id AND oa.groupid \u003d 103 AND oa.operationid \u003d 0) THEN \u0027MEDIN\u0027\n ELSE \u0027-\u0027\n END \n ) AS \"Groups Available in (GEMINI / MEDIN)\",\n\n -- Add in section as to whether in public view\n(\n CASE WHEN EXISTS (\n SELECT \n 1 \n FROM \n operationallowed oa \n WHERE \n oa.metadataid \u003d mx.id \n AND oa.groupid \u003d 1 \n AND oa.operationid \u003d 0\n ) THEN \u0027Public record\u0027 ELSE \u0027Private record\u0027 END\n ) AS \"Record in Public view\" \n\nFROM custom.metadata_xml mx\nJOIN (\n SELECT DISTINCT ON (uuid) uuid, changedate, userid FROM metadatastatus ORDER BY uuid, changedate DESC, userid\n ) ms ON mx.uuid \u003d ms.uuid \nJOIN users u ON ms.userid \u003d u.id \n\nWHERE (mx.istemplate \u003d \u0027n\u0027 OR mx.istemplate \u003d \u0027y\u0027)\nAND mx.uuid \u003d \u0027${NRW File identifier}\u0027\n\nLIMIT 4000;",
      "user": "anonymous",
