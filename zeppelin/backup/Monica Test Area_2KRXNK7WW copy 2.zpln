    {
      "title": "2. Report on Keywords all as character (except GEMET)",
      "text": "-- This report returns the keywords for every records assuming that all records have anchor strings for GEMET keywords and all other keywords are character strings (but MEDIN keywords may be mixture of Anchor and character)\n\n-- This selects from parts of the system that are not within the XML of the individual records\n-- Working copy build to help me expand to full report on all keywordss\n\nSELECT\n  mx.uuid AS \"NRW File identifier\",\n  mx.createdate AS \"Date Created\",\n\n-- The following code selects elements out of the XML Data column i.e from the records themselves\n\n  -- Title\n  array_to_string(\n    xpath('/gmd:MD_Metadata/gmd:identificationInfo/gmd:MD_DataIdentification/gmd:citation/gmd:CI_Citation/gmd:title/gco:CharacterString/text()'::text, \n          mx.data_xml, \n          '{{gco,http://www.isotc211.org/2005/gco},\n            {gmd,http://www.isotc211.org/2005/gmd}}'::text[]), \n    '-'::text\n  ) AS \"Title\",\n\n \n\n  -- INSPIRE Theme Keywords under descriptive Keywords - Anchor tag\n array_to_string(\n    xpath(\n      '//gmd:descriptiveKeywords/gmd:MD_Keywords[gmd:type/gmd:MD_KeywordTypeCode[@codeListValue=\"theme\"]\n         and\n         gmd:thesaurusName//gmx:Anchor[text()=\"GEMET - INSPIRE themes, version 1.0\"]]/gmd:keyword/gmx:Anchor/text()'::text,\n      mx.data_xml,\n      '{{gmd,http://www.isotc211.org/2005/gmd},\n        {gmx,http://www.isotc211.org/2005/gmx},\n        {xlink,http://www.w3.org/1999/xlink}}'::text[]\n    ),\n    ', '::text\n  ) AS \"GEMET Keywords\",\n  \n  -- Keywords - characer strings\n-- NRW Keywords\narray_to_string(\n  xpath(\n    '//gmd:MD_Keywords[gmd:thesaurusName/gmd:CI_Citation/gmd:title/gco:CharacterString[contains(text(), \"NRW Thesaurus\")]]/gmd:keyword/gco:CharacterString/text()'::text,\n    mx.data_xml,\n    ARRAY[\n      ARRAY['gco', 'http://www.isotc211.org/2005/gco'],\n      ARRAY['gmd', 'http://www.isotc211.org/2005/gmd'],\n      ARRAY['gmx', 'http://www.isotc211.org/2005/gmx']\n    ]\n  ),\n  ', '\n) AS \"NRW Keywords\",\n\n-- SeaDataNet Keywords\narray_to_string(\n  xpath(\n    '//gmd:MD_Keywords[gmd:thesaurusName/gmd:CI_Citation/gmd:title/gco:CharacterString[contains(text(), \"SeaDataNet Parameter Discovery Vocabulary\")]]/gmd:keyword/gco:CharacterString/text()'::text,\n    mx.data_xml,\n    ARRAY[\n      ARRAY['gco', 'http://www.isotc211.org/2005/gco'],\n      ARRAY['gmd', 'http://www.isotc211.org/2005/gmd'],\n      ARRAY['gmx', 'http://www.isotc211.org/2005/gmx']\n    ]\n  ),\n  ', '\n) AS \"SeaDataNet/MEDIN Keywords\",\n\n-- IPSV Keywords\narray_to_string(\n  xpath(\n    '//gmd:MD_Keywords[gmd:thesaurusName/gmd:CI_Citation/gmd:title/gco:CharacterString[contains(text(), \"IPSV Subjects List\")]]/gmd:keyword/gco:CharacterString/text()'::text,\n    mx.data_xml,\n    ARRAY[\n      ARRAY['gco', 'http://www.isotc211.org/2005/gco'],\n      ARRAY['gmd', 'http://www.isotc211.org/2005/gmd'],\n      ARRAY['gmx', 'http://www.isotc211.org/2005/gmx']\n    ]\n  ),\n  ', '\n) AS \"IPSV Keywords\",\n\n-- SMNR Keywords\narray_to_string(\n  xpath(\n    '//gmd:MD_Keywords[gmd:thesaurusName/gmd:CI_Citation/gmd:title/gco:CharacterString[contains(text(), \"NRW SMNR Keywords\")]]/gmd:keyword/gco:CharacterString/text()'::text,\n    mx.data_xml,\n    ARRAY[\n      ARRAY['gco', 'http://www.isotc211.org/2005/gco'],\n      ARRAY['gmd', 'http://www.isotc211.org/2005/gmd'],\n      ARRAY['gmx', 'http://www.isotc211.org/2005/gmx']\n    ]\n  ),\n  ', '\n) AS \"SMNR Keywords\",\n\n\n\n-- Added in information aboutthe records status\n-- identify if they already went through validaton process  \n  (CASE\n        WHEN EXISTS (\n            SELECT 1\n            FROM validation\n            WHERE metadataid = mx.id AND required = 'true' AND failed != 0\n        ) THEN 'Invalid'\n        WHEN EXISTS (\n            SELECT 1\n            FROM validation\n            WHERE metadataid = mx.id AND required = 'true' AND failed = 0\n        ) THEN 'Valid'\n        ELSE 'Unknown'\n    END\n  ) AS \"Validation Status\",\n\n--  to identify if they are relevant to MEDIN or data.gov as will be prioroty to fix before harvest \n  (CASE\n        WHEN EXISTS (SELECT 1 FROM operationallowed oa WHERE oa.metadataid = mx.id AND oa.groupid = 102 AND oa.operationid = 0) AND EXISTS (SELECT 1 FROM operationallowed oa2 WHERE oa2.metadataid = mx.id AND oa2.groupid = 103 AND oa2.operationid = 0) THEN 'GEMINI & MEDIN'\n        WHEN EXISTS (SELECT 1 FROM operationallowed oa WHERE oa.metadataid = mx.id AND oa.groupid = 102 AND oa.operationid = 0) THEN 'GEMINI'\n        WHEN EXISTS (SELECT 1 FROM operationallowed oa WHERE oa.metadataid = mx.id AND oa.groupid = 103 AND oa.operationid = 0) THEN 'MEDIN'\n        ELSE '-'\n    END \n  ) AS \"Groups Available in (GEMINI / MEDIN)\",\n\n-- Add in section as to whether in public view\n(\n    CASE WHEN EXISTS (\n      SELECT \n        1 \n      FROM \n        operationallowed oa \n      WHERE \n        oa.metadataid = mx.id \n        AND oa.groupid = 1 \n        AND oa.operationid = 0\n    ) THEN 'Public record' ELSE 'Private record' END\n  ) AS \"Record in Public view\" \n\nFROM custom.metadata_xml mx\nWHERE (mx.istemplate = 'n' OR mx.istemplate = 'y')\n\n--enable this if you want  to select a specific file\n--AND mx.uuid = '${NRW File identifier}' \n\nLIMIT 4000;",
      "user": "admin",
      "dateUpdated": "2026-02-26 15:20:29.459",
