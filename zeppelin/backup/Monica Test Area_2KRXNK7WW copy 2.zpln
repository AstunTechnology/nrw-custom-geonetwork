    {
      "title": "NRW Access and Use Constraints report version 2 (Monica)",
      "text": "-- The following report exports all the records and the Use and Access Constraints so we can validate that the correct elements have been populated and that there are not hidden duplicates (viwed through advanced view).  Andy created this as report AJ Constraints in the NRW Reports Notebook and I have just annotated and amended the order and the column names for easier use by staff (MJ 03/04/2025).  We will retain the DELETE column even after the records have been validated to ensure they don\u0027t get populated by mistake\n\n\nselect\n\n mx.uuid AS \"NRW File identifier\",\n \n -- The following code selects elements out of the XML Data column\n\n -- Title of the Record\n array_to_string(xpath(\u0027/gmd:MD_Metadata/gmd:identificationInfo/gmd:MD_DataIdentification/gmd:citation/gmd:CI_Citation/gmd:title/gco:CharacterString/text()\u0027::text, mx.data_xml, \u0027{{gco,http://www.isotc211.org/2005/gco},{gmd,http://www.isotc211.org/2005/gmd}}\u0027::text[]), \u0027-\u0027::text) AS \"Title\",\n \n-- Limitations on Public Access and Use \n    --Restriction type\n array_to_string(\n    xpath(\n      \u0027/gmd:MD_Metadata/gmd:identificationInfo/gmd:MD_DataIdentification/gmd:resourceConstraints/gmd:MD_LegalConstraints/gmd:accessConstraints/gmd:MD_RestrictionCode/@codeListValue\u0027 :: text, \n      mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gco,http://www.isotc211.org/2005/gco}}\u0027 :: text[]\n    ), \n    \u0027-\u0027 :: text\n  ) AS \"Restriction type\",\n \n-- Access Contraints Directive\narray_to_string(\n    xpath(\n      \u0027/gmd:MD_Metadata/gmd:identificationInfo/gmd:MD_DataIdentification/gmd:resourceConstraints[1]/gmd:MD_LegalConstraints/gmd:otherConstraints[2]/gmx:Anchor/text()\u0027 :: text, \n      mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gmx,http://www.isotc211.org/2005/gmx}}\u0027 :: text[]\n    ), \n    \u0027-\u0027 :: text\n  ) AS \"Access Constraints Directive\",\n\n \n--Access Constraints Text\n    -- Access Constraints\n array_to_string(\n    xpath(\n      \u0027/gmd:MD_Metadata/gmd:identificationInfo/gmd:MD_DataIdentification/gmd:resourceConstraints[1]/gmd:MD_LegalConstraints/gmd:otherConstraints/gco:CharacterString/text()\u0027 :: text, \n      mx.data_xml, \u0027{{gco,http://www.isotc211.org/2005/gco},{gmd,http://www.isotc211.org/2005/gmd},{nrw,http://naturalresources.wales/nrw}}\u0027 :: text[]\n    ), \n    \u0027-\u0027 :: text\n  ) AS \"Access Constraints TEXT\",\n\n--Use Constraints\n    --Use Constraints Type\narray_to_string(\n    xpath(\n      \u0027/gmd:MD_Metadata/gmd:identificationInfo/gmd:MD_DataIdentification/gmd:resourceConstraints[2]/gmd:MD_LegalConstraints/gmd:useConstraints/gmd:MD_RestrictionCode/@codeListValue\u0027 :: text, \n      mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gmx,http://www.isotc211.org/2005/gmx}}\u0027 :: text[]\n    ), \n    \u0027-\u0027 :: text\n  ) AS \"Use Constraints Type\",\n    \n    --Use Constraints\n array_to_string(\n    xpath(\n      \u0027/gmd:MD_Metadata/gmd:identificationInfo/gmd:MD_DataIdentification/gmd:resourceConstraints[2]/gmd:MD_LegalConstraints/gmd:otherConstraints[1]/gco:CharacterString/text()\u0027 :: text, \n      mx.data_xml, \u0027{{gco,http://www.isotc211.org/2005/gco},{gmd,http://www.isotc211.org/2005/gmd},{nrw,http://naturalresources.wales/nrw}}\u0027 :: text[]\n    ), \n    \u0027-\u0027 :: text\n  ) AS \"Use Constraints TEXT\", \n\t\n--Attribution Statement\n    --Attribution Statement\narray_to_string(\n    xpath(\n      \u0027/gmd:MD_Metadata/gmd:identificationInfo/gmd:MD_DataIdentification/gmd:resourceConstraints[2]/gmd:MD_LegalConstraints/gmd:otherConstraints[2]/gco:CharacterString/text()\u0027 :: text, \n      mx.data_xml, \u0027{{gco,http://www.isotc211.org/2005/gco},{gmd,http://www.isotc211.org/2005/gmd},{nrw,http://naturalresources.wales/nrw}}\u0027 :: text[]\n    ), \n    \u0027-\u0027 :: text\n  ) AS \"Attribution Statement\",\t\n \n--Licence\n  array_to_string(\n    xpath(\n      \u0027/gmd:MD_Metadata/gmd:identificationInfo/gmd:MD_DataIdentification/gmd:resourceConstraints/gmd:MD_LegalConstraints[gmd:useConstraints]/gmd:otherConstraints/gmx:Anchor/text()\u0027 :: text, \n      mx.data_xml, \u0027{{gmx,http://www.isotc211.org/2005/gmx},{gmd,http://www.isotc211.org/2005/gmd}}\u0027 :: text[]\n    ), \n    \u0027-\u0027 :: text\n  ) AS \"Licence\",\n\n-- The following are the two unused elements that are hidden in the Advanced view and have been populated incorrectly as part of the migration.  The content needs to be removed for identified records\n    --Attribution Statement - duplicate not required THE ACTUAL RECORDS NEED AMENDING\narray_to_string(\n    xpath(\n      \u0027/gmd:MD_Metadata/gmd:identificationInfo/gmd:MD_DataIdentification/gmd:resourceConstraints[2]/gmd:MD_LegalConstraints/gmd:otherConstraints[3]/gco:CharacterString/text()\u0027 :: text, \n      mx.data_xml, \u0027{{gco,http://www.isotc211.org/2005/gco},{gmd,http://www.isotc211.org/2005/gmd},{nrw,http://naturalresources.wales/nrw}}\u0027 :: text[]\n    ), \n    \u0027-\u0027 :: text\n  ) AS \"Attribution Statement2 - DELETE in Advanced View\",\t\n\n     --Licence - duplicate not required THE ACTUAL RECORDS NEED AMENDING\n  array_to_string(\n    xpath(\n      \u0027/gmd:MD_Metadata/gmd:identificationInfo/gmd:MD_DataIdentification/gmd:resourceConstraints[2]/gmd:MD_LegalConstraints/gmd:otherConstraints[4]/gmx:Anchor/text()\u0027 :: text, \n      mx.data_xml, \u0027{{gmx,http://www.isotc211.org/2005/gmx},{gmd,http://www.isotc211.org/2005/gmd}}\u0027 :: text[]\n    ), \n    \u0027-\u0027 :: text\n  ) AS \"Licence2 - DELETE in Advanced View\",\n\n\n-- Added in column to identify if they already went through validaton process  \n  (CASE\n\t        WHEN EXISTS (\n\t            SELECT 1\n\t            FROM validation\n\t            WHERE metadataid \u003d mx.id AND required \u003d \u0027true\u0027 AND failed !\u003d 0\n\t        ) THEN \u0027Invalid\u0027\n\t        WHEN EXISTS (\n\t            SELECT 1\n\t            FROM validation\n\t            WHERE metadataid \u003d mx.id AND required \u003d \u0027true\u0027 AND failed \u003d 0\n\t        ) THEN \u0027Valid\u0027\n\t        ELSE \u0027Unknown\u0027\n\t    END\n\t) AS \"Validation Status\",\n\n-- Added in column to identify if they are relevant to MEDIN or data.gov as will be prioroty to fix before harvest \t\n\t(CASE\n\t        WHEN EXISTS (SELECT 1 FROM operationallowed oa WHERE oa.metadataid \u003d mx.id AND oa.groupid \u003d 102 AND oa.operationid \u003d 0) AND EXISTS (SELECT 1 FROM operationallowed oa2 WHERE oa2.metadataid \u003d mx.id AND oa2.groupid \u003d 103 AND oa2.operationid \u003d 0) THEN \u0027GEMINI \u0026 MEDIN\u0027\n\t        WHEN EXISTS (SELECT 1 FROM operationallowed oa WHERE oa.metadataid \u003d mx.id AND oa.groupid \u003d 102 AND oa.operationid \u003d 0) THEN \u0027GEMINI\u0027\n\t        WHEN EXISTS (SELECT 1 FROM operationallowed oa WHERE oa.metadataid \u003d mx.id AND oa.groupid \u003d 103 AND oa.operationid \u003d 0) THEN \u0027MEDIN\u0027\n\t        ELSE \u0027-\u0027\n\t    END \n\t) AS \"Groups Available in (GEMINI / MEDIN)\"\n\n\t\n\t\n  from custom.metadata_xml mx\n \n WHERE (mx.istemplate \u003d \u0027n\u0027 OR mx.istemplate \u003d \u0027y\u0027)\n\n --enable the code below to select a specific reord only\n --AND mx.uuid \u003d \u0027${NRW File identifier}\u0027 \n\n-- Amend the number to 5 if you just want to test for a few record.  Running 4000 will export whole catalogue unless the Specific record code (above) is enabled\nLIMIT 4000;\n\n",
      "user": "anonymous",
      "dateUpdated": "2026-03-04 16:57:44.694",
      "progress": 0,
