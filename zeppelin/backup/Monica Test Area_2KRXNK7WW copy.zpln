          {
            "type": "TABLE",
            "data": "Database ID\tNRW File identifier\tTitle\tResource Identifier\tNRW Internal Location\tNRW Internal Custodian\tOwner organisation\tLicence\tValidation Status\tEdit Status\tDate Last Edited\tLast Editor Name\tGroups Available in (GEMINI / MEDIN)\tRecord in Public view\n17067\tEXT_DS100183\tWelsh Government: Land Parcel Identification System (LPIS) Crop Codes (3rd Party Data)\t4f4c4942-4343-5764-6473-313030313833\tLegacy CCW Archive M:\\GIS_Data\\live\\Land_management\\agrienvironment\\WAG_DEPC\\lpis\\crop_codes_all.TAB\tGIS and Spatial Data Team\tWelsh Government\t\tUnknown\tEditable\t2025-03-07T15:59:13.000Z\tAstun Technology Admin\t-\tPrivate record\n17069\tEXT_DS100191\tWelsh Government: Land Parcel Identification System (LPIS) Farm and Field Boundaries (3rd Party Data)\t4f4c4942-4343-5764-6473-313030313931\tx:\\Resource Management\\Welsh Government\\LPIS Farm and field boundary join unredacted.lyr  x:\\Resource Management\\Welsh Government\\LPIS Farm Boundaries.lyr  x:\\Resource Management\\Welsh Government\\LPIS Field Boundaries Redacted.lyr  x:\\Resource Management\\Welsh Government\\LPIS Field Boundaries Unredacted.lyr  Legacy CCW Archive M:\\gis_data\\live\\land_management\\agrienvironment\\wag_depc\\lpis\\lpis_farm_bdy.tab\tGIS Service Desk\tWelsh Government\t\tUnknown\tEditable\t2026-01-26T10:04:06.000Z\tMonica Jones\t-\tPublic record\n17066\tEXT_DS100682\tEnvironment Agency (EA): Local Environment Agency Plans (LEAPs) boundaries (3rd Party Data)\t4f4c4942-4343-5764-6473-313030363832\tLegacy CCW Archive M:\\gis_data\\live\\physical\\hydrology\\environment_agency\\agency_infrastructure\\leaps_250k.tab\tGIS Service Desk\tEnvironment Agency Wales (EA Wales)\t\tUnknown\tEditable\t2025-03-21T10:38:23.000Z\tnobody nobody\t-\tPublic record\n17072\tEXT_DS100758\tWelsh Government: Less Favoured Areas (LFA) (3rd Party Data)\t4f4c4942-4343-5764-6473-313030373538\tx:\\Resource Management\\Welsh Government\\Less Favoured Areas.lyr\tGIS Service Desk\tWelsh Government\t\tUnknown\tEditable\t2025-07-08T08:21:14.000Z\tnobody nobody\t-\tPublic record\n"
