    {
      "title": "3. Report on all Keywords (anchor or character)",
      "text": "-- This report returns the keywords for every records assuming that we do not know if they are anchor strings or character strings\r\n-- The report is deigned to help us find records where no keywords are assigned.  Please not that \r\n            --only GEMET keywords are mandatory for all records\r\n            --NRW keywords are recommended for all records\r\n            --MEDIN/SeaDataNet keywords are mandatory for marine records and not required for other records\r\n            --IPSV Keywords are obsolete and not required\r\n            --SMNR keywords may be obsolete and not required for new records but Steve Newstead is undecded if they may have a use in future with WEIP portal and DataHub\r\n        --Please note that some keywords may return as blank if the reord has not been \"committed\" (i.e. had a save since it was migrated) in the system. - This is a misunderstanding.  Records may be returned as blank as Elena advised that I may have used the  NULLIF(array_to_string()) logic incorrectly\r\n        \r\n        --THIS REPORT CAN BE REPLACED WITH THE COMPREHENIVE ONE THAT ELENA CREATED CALLED Elena - Report on all keywords\r\n\r\n-- This selects from parts of the system that are not within the XML of the individual records\r\n\r\nSELECT\r\n  mx.uuid AS \"NRW File identifier\",\r\n  mx.createdate AS \"Date Created\",\r\n  /*Other */\r\n  ms.changedate AS \"Date Last Edited\", \r\n  u.name || \u0027 \u0027 || u.surname AS \"Last Editor Name\",\r\n\r\n-- The following code selects elements out of the XML Data column i.e from the records themselves\r\n\r\n  -- Title\r\n  array_to_string(\r\n    xpath(\u0027/gmd:MD_Metadata/gmd:identificationInfo/gmd:MD_DataIdentification/gmd:citation/gmd:CI_Citation/gmd:title/gco:CharacterString/text()\u0027::text, \r\n          mx.data_xml, \r\n          \u0027{{gco,http://www.isotc211.org/2005/gco},\r\n            {gmd,http://www.isotc211.org/2005/gmd}}\u0027::text[]), \r\n    \u0027-\u0027::text\r\n  ) AS \"Title\",\r\n\r\n-- INSPIRE Theme Keywords under descriptiveKeywords\r\n array_to_string(\r\n    xpath(\r\n      \u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[gmd:type/gmd:MD_KeywordTypeCode[@codeListValue\u003d\"theme\"]\r\n         and\r\n         gmd:thesaurusName//gmx:Anchor[text()\u003d\"GEMET - INSPIRE themes, version 1.0\"]]/gmd:keyword/gmx:Anchor/text()\u0027::text,\r\n      mx.data_xml,\r\n      \u0027{{gmd,http://www.isotc211.org/2005/gmd},\r\n        {gmx,http://www.isotc211.org/2005/gmx},\r\n        {xlink,http://www.w3.org/1999/xlink}}\u0027::text[]\r\n    ),\r\n    \u0027, \u0027::text\r\n  ) AS \"GEMET Keywords\",\r\n\r\n-- *********************************************************************************************************************\r\n--Other Keywords are an issue as new records (MEDIN) have anchor string and migrated records have a character string.  This text allows it to \r\n--NULLIF(..., \u0027\u0027) turns empty strings into NULL.\r\n--ARRAY[...] collects both keyword sources.\r\n--array_remove(..., \u0027\u0027) removes any remaining empty strings.\r\n--array_to_string(..., \u0027, \u0027) joins only the non-empty parts with commas — no leading comma.\r\n--*********************************************************************************************************************\r\n\r\n-- NRW Keywords\r\narray_to_string(\r\n  array_remove(\r\n    ARRAY[\r\n      NULLIF(array_to_string(\r\n        xpath(\r\n          \u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[\r\n            gmd:type/gmd:MD_KeywordTypeCode[@codeListValue\u003d\"theme\"]\r\n            and\r\n            gmd:thesaurusName//gmx:Anchor[contains(text(), \"NRW Thesaurus\")]\r\n          ]/gmd:keyword/gmx:Anchor/text()\u0027::text,\r\n          mx.data_xml,\r\n          \u0027{{gmd,http://www.isotc211.org/2005/gmd},\r\n            {gmx,http://www.isotc211.org/2005/gmx},\r\n            {xlink,http://www.w3.org/1999/xlink}}\u0027::text[]\r\n        ),\r\n        \u0027, \u0027::text\r\n      ), \u0027\u0027),\r\n      \r\n      NULLIF(array_to_string(\r\n        xpath(\r\n          \u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[\r\n            gmd:type/gmd:MD_KeywordTypeCode[@codeListValue\u003d\"theme\"]\r\n            and\r\n            gmd:thesaurusName//gco:CharacterString[contains(text(), \"NRW Thesaurus\")]\r\n          ]/gmd:keyword/gco:CharacterString/text()\u0027::text,\r\n          mx.data_xml,\r\n          \u0027{{gmd,http://www.isotc211.org/2005/gmd},\r\n            {gco,http://www.isotc211.org/2005/gco},\r\n            {xlink,http://www.w3.org/1999/xlink}}\u0027::text[]\r\n        ),\r\n        \u0027, \u0027::text\r\n      ), \u0027\u0027)\r\n    ],\r\n    \u0027\u0027\r\n  ),\r\n  \u0027, \u0027\r\n) AS \"NRW Keywords\",\r\n\r\n\r\n--MEDIN/SeaDataNet Keywords\r\narray_to_string(\r\n  array_remove(\r\n    ARRAY[\r\n      NULLIF(array_to_string(\r\n        xpath(\r\n          \u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[\r\n            gmd:type/gmd:MD_KeywordTypeCode[@codeListValue\u003d\"theme\"]\r\n            and\r\n            gmd:thesaurusName//gmx:Anchor[contains(text(), \"SeaDataNet Parameter Discovery Vocabulary\")]\r\n          ]/gmd:keyword/gmx:Anchor/text()\u0027::text,\r\n          mx.data_xml,\r\n          \u0027{{gmd,http://www.isotc211.org/2005/gmd},\r\n            {gmx,http://www.isotc211.org/2005/gmx},\r\n            {xlink,http://www.w3.org/1999/xlink}}\u0027::text[]\r\n        ),\r\n        \u0027, \u0027\r\n      ), \u0027\u0027),\r\n      NULLIF(array_to_string(\r\n        xpath(\r\n          \u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[\r\n            gmd:type/gmd:MD_KeywordTypeCode[@codeListValue\u003d\"theme\"]\r\n            and\r\n            gmd:thesaurusName//gco:CharacterString[contains(text(), \"SeaDataNet Parameter Discovery Vocabulary\")]\r\n          ]/gmd:keyword/gco:CharacterString/text()\u0027::text,\r\n          mx.data_xml,\r\n          \u0027{{gmd,http://www.isotc211.org/2005/gmd},\r\n            {gco,http://www.isotc211.org/2005/gco},\r\n            {xlink,http://www.w3.org/1999/xlink}}\u0027::text[]\r\n        ),\r\n        \u0027, \u0027\r\n      ), \u0027\u0027)\r\n    ],\r\n    \u0027\u0027\r\n  ),\r\n  \u0027, \u0027\r\n) AS \"SeaDataNet/MEDIN Keywords\",\r\n\r\n--IPSV Keywords\r\narray_to_string(\r\n  array_remove(\r\n    ARRAY[\r\n      NULLIF(array_to_string(\r\n        xpath(\r\n          \u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[\r\n            gmd:type/gmd:MD_KeywordTypeCode[@codeListValue\u003d\"theme\"]\r\n            and\r\n            gmd:thesaurusName//gmx:Anchor[contains(text(), \"IPSV Subjects List\")]\r\n          ]/gmd:keyword/gmx:Anchor/text()\u0027::text,\r\n          mx.data_xml,\r\n          \u0027{{gmd,http://www.isotc211.org/2005/gmd},\r\n            {gmx,http://www.isotc211.org/2005/gmx},\r\n            {xlink,http://www.w3.org/1999/xlink}}\u0027::text[]\r\n        ),\r\n        \u0027, \u0027\r\n      ), \u0027\u0027),\r\n      NULLIF(array_to_string(\r\n        xpath(\r\n          \u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[\r\n            gmd:type/gmd:MD_KeywordTypeCode[@codeListValue\u003d\"theme\"]\r\n            and\r\n            gmd:thesaurusName//gco:CharacterString[contains(text(), \"IPSV Subjects List\")]\r\n          ]/gmd:keyword/gco:CharacterString/text()\u0027::text,\r\n          mx.data_xml,\r\n          \u0027{{gmd,http://www.isotc211.org/2005/gmd},\r\n            {gco,http://www.isotc211.org/2005/gco},\r\n            {xlink,http://www.w3.org/1999/xlink}}\u0027::text[]\r\n        ),\r\n        \u0027, \u0027\r\n      ), \u0027\u0027)\r\n    ],\r\n    \u0027\u0027\r\n  ),\r\n  \u0027, \u0027\r\n) AS \"IPSV Keywords\",\r\n\r\n\r\n--SMNR\r\n\r\narray_to_string(\r\n  array_remove(\r\n    ARRAY[\r\n      NULLIF(array_to_string(\r\n        xpath(\r\n          \u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[\r\n            gmd:type/gmd:MD_KeywordTypeCode[@codeListValue\u003d\"theme\"]\r\n            and\r\n            gmd:thesaurusName//gmx:Anchor[contains(text(), \"NRW SMNR Keywords\")]\r\n          ]/gmd:keyword/gmx:Anchor/text()\u0027::text,\r\n          mx.data_xml,\r\n          \u0027{{gmd,http://www.isotc211.org/2005/gmd},\r\n            {gmx,http://www.isotc211.org/2005/gmx},\r\n            {xlink,http://www.w3.org/1999/xlink}}\u0027::text[]\r\n        ),\r\n        \u0027, \u0027\r\n      ), \u0027\u0027),\r\n      NULLIF(array_to_string(\r\n        xpath(\r\n          \u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[\r\n            gmd:type/gmd:MD_KeywordTypeCode[@codeListValue\u003d\"theme\"]\r\n            and\r\n            gmd:thesaurusName//gco:CharacterString[contains(text(), \"NRW SMNR Keywords\")]\r\n          ]/gmd:keyword/gco:CharacterString/text()\u0027::text,\r\n          mx.data_xml,\r\n          \u0027{{gmd,http://www.isotc211.org/2005/gmd},\r\n            {gco,http://www.isotc211.org/2005/gco},\r\n            {xlink,http://www.w3.org/1999/xlink}}\u0027::text[]\r\n        ),\r\n        \u0027, \u0027\r\n      ), \u0027\u0027)\r\n    ],\r\n    \u0027\u0027\r\n  ),\r\n  \u0027, \u0027\r\n) AS \"SMNR Keywords\",\r\n\r\n\r\n\r\n-- Added in information aboutthe records status\r\n-- identify if they already went through validaton process  \r\n  (CASE\r\n\t        WHEN EXISTS (\r\n\t            SELECT 1\r\n\t            FROM validation\r\n\t            WHERE metadataid \u003d mx.id AND required \u003d \u0027true\u0027 AND failed !\u003d 0\r\n\t        ) THEN \u0027Invalid\u0027\r\n\t        WHEN EXISTS (\r\n\t            SELECT 1\r\n\t            FROM validation\r\n\t            WHERE metadataid \u003d mx.id AND required \u003d \u0027true\u0027 AND failed \u003d 0\r\n\t        ) THEN \u0027Valid\u0027\r\n\t        ELSE \u0027Unknown\u0027\r\n\t    END\r\n\t) AS \"Validation Status\",\r\n\r\n--  to identify if they are relevant to MEDIN or data.gov as will be prioroty to fix before harvest \t\r\n\t(CASE\r\n\t        WHEN EXISTS (SELECT 1 FROM operationallowed oa WHERE oa.metadataid \u003d mx.id AND oa.groupid \u003d 102 AND oa.operationid \u003d 0) AND EXISTS (SELECT 1 FROM operationallowed oa2 WHERE oa2.metadataid \u003d mx.id AND oa2.groupid \u003d 103 AND oa2.operationid \u003d 0) THEN \u0027GEMINI \u0026 MEDIN\u0027\r\n\t        WHEN EXISTS (SELECT 1 FROM operationallowed oa WHERE oa.metadataid \u003d mx.id AND oa.groupid \u003d 102 AND oa.operationid \u003d 0) THEN \u0027GEMINI\u0027\r\n\t        WHEN EXISTS (SELECT 1 FROM operationallowed oa WHERE oa.metadataid \u003d mx.id AND oa.groupid \u003d 103 AND oa.operationid \u003d 0) THEN \u0027MEDIN\u0027\r\n\t        ELSE \u0027-\u0027\r\n\t    END \r\n\t) AS \"Groups Available in (GEMINI / MEDIN)\",\r\n\r\n\r\n-- Add in section as to whether in public view\r\n(\r\n    CASE WHEN EXISTS (\r\n      SELECT \r\n        1 \r\n      FROM \r\n        operationallowed oa \r\n      WHERE \r\n        oa.metadataid \u003d mx.id \r\n        AND oa.groupid \u003d 1 \r\n        AND oa.operationid \u003d 0\r\n    ) THEN \u0027Public record\u0027 ELSE \u0027Private record\u0027 END\r\n  ) AS \"Record in Public view\" \r\n\r\nFROM custom.metadata_xml mx\r\nJOIN (\r\n    SELECT \r\n      DISTINCT ON (uuid) uuid, \r\n      changedate, \r\n      userid \r\n    FROM \r\n      metadatastatus \r\n    ORDER BY \r\n      uuid, \r\n      changedate DESC, \r\n      userid\r\n  ) ms ON mx.uuid \u003d ms.uuid \r\n  JOIN users u ON ms.userid \u003d u.id \r\n\r\nWHERE (mx.istemplate \u003d \u0027n\u0027 OR mx.istemplate \u003d \u0027y\u0027)\r\n\r\n\r\n\r\n--enable this if you want  to select a specific file\r\nAND mx.uuid \u003d \u0027${NRW File identifier}\u0027 \r\n\r\n--N.B. If the keywords are not returning thsi is bacause a change in the past needs to be enacted, by ging into edit mode on the records.  once saved, even if no change the keywords then appear.  How do we enact a save on all record sto comit any changes from old bulkor migrated edit\r\nLIMIT 4000;",
      "user": "monica.jones_reporting",
      "dateUpdated": "2026-02-26 15:20:32.318",
