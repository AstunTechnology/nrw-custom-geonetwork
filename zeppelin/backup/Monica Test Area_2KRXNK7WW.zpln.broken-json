    {
      "title": "5. SeaDataNet Keywords (anchor or character) and type",
      "text": "-- All Marine records require a MEDIN/SeaDataNet keyword to be added as Mandaory.  Best practice requires these keywords to be added as Anchor strings rather than character strings, however the template will only add them as charcter strings and the data editor needs to  remember to amend the Keyword type to anchor, using the cog setting.  This report is produced to idetify records where the MEDIN keyword has not been added as an anchor string\r\n-- THis report didn\u0027t really work and can be replaced with Elenas All Keyword report - which coul djust be slimmed down to the MEDIN Keywords so can be run regulaly without lots of filters\r\n\r\n-- This selects from parts of the system that are not within the XML of the individual records\r\n\r\nSELECT\r\n  mx.uuid AS \"NRW File identifier\",\r\n  mx.createdate AS \"Date Created\",\r\n  /*Other */\r\n  ms.changedate AS \"Date Last Edited\", \r\n  u.name || \u0027 \u0027 || u.surname AS \"Last Editor Name\",\r\n\r\n-- The following code selects elements out of the XML Data column i.e from the records themselves\r\n\r\n  -- Title\r\n  array_to_string(\r\n    xpath(\u0027/gmd:MD_Metadata/gmd:identificationInfo/gmd:MD_DataIdentification/gmd:citation/gmd:CI_Citation/gmd:title/gco:CharacterString/text()\u0027::text, \r\n          mx.data_xml, \r\n          \u0027{{gco,http://www.isotc211.org/2005/gco},\r\n            {gmd,http://www.isotc211.org/2005/gmd}}\u0027::text[]), \r\n    \u0027-\u0027::text\r\n  ) AS \"Title\",\r\n\r\n\r\n--Add in a new column that identifies the colum as \"blank\" (i.e. not added to the records) or \"missing\" (i.e. added to the records but with no cotent and therefore needs to be removed)\r\n\r\n--MEDIN/SeaDataNet Keywords - adds the keyword into a new column but puts missing if blank or missing (so don\u0027t think it has differentiated.  I need to get it to put blank for records where nothing in schema and Missing where the block is there but the keywords itsef is missing)\r\n\r\nCOALESCE(\r\n  NULLIF(\r\n    array_to_string(\r\n      array_remove(\r\n        ARRAY[\r\n          NULLIF(array_to_string(\r\n            xpath(\r\n              \u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[\r\n                gmd:type/gmd:MD_KeywordTypeCode[@codeListValue\u003d\"theme\"]\r\n                and\r\n                gmd:thesaurusName//gmx:Anchor[contains(text(), \"SeaDataNet Parameter Discovery Vocabulary\")]\r\n              ]/gmd:keyword/gmx:Anchor/text()\u0027::text,\r\n              mx.data_xml,\r\n              \u0027{{gmd,http://www.isotc211.org/2005/gmd},\r\n                {gmx,http://www.isotc211.org/2005/gmx},\r\n                {xlink,http://www.w3.org/1999/xlink}}\u0027::text[]\r\n            ),\r\n            \u0027, \u0027\r\n          ), \u0027\u0027),\r\n          NULLIF(array_to_string(\r\n            xpath(\r\n              \u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[\r\n                gmd:type/gmd:MD_KeywordTypeCode[@codeListValue\u003d\"theme\"]\r\n                and\r\n                gmd:thesaurusName//gco:CharacterString[contains(text(), \"SeaDataNet Parameter Discovery Vocabulary\")]\r\n              ]/gmd:keyword/gco:CharacterString/text()\u0027::text,\r\n              mx.data_xml,\r\n              \u0027{{gmd,http://www.isotc211.org/2005/gmd},\r\n                {gco,http://www.isotc211.org/2005/gco},\r\n                {xlink,http://www.w3.org/1999/xlink}}\u0027::text[]\r\n            ),\r\n            \u0027, \u0027\r\n          ), \u0027\u0027)\r\n        ],\r\n        \u0027\u0027\r\n      ),\r\n      \u0027, \u0027\r\n    ),\r\n    \u0027\u0027\r\n  ),\r\n  \u0027Missing\u0027\r\n) AS \"MEDIN/SeaDataNet Keywords\",\r\n\r\n\r\n\r\n--This adds in a new column that identifies if the records is an anchor or a Character\r\n\r\n(\r\n  CASE\r\n    WHEN EXISTS (\r\n      SELECT 1 FROM unnest(xpath(\r\n        \u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[\r\n          gmd:type/gmd:MD_KeywordTypeCode[@codeListValue\u003d\"theme\"]\r\n          and gmd:thesaurusName//gmx:Anchor[contains(text(), \"SeaDataNet Parameter Discovery Vocabulary\")]\r\n        ]/gmd:keyword/gmx:Anchor/text()\u0027,\r\n        mx.data_xml,\r\n        \u0027{{gmd,http://www.isotc211.org/2005/gmd},\r\n          {gmx,http://www.isotc211.org/2005/gmx},\r\n          {xlink,http://www.w3.org/1999/xlink}}\u0027::text[]\r\n      ))\r\n    ) THEN \u0027Anchor\u0027\r\n    \r\n    WHEN EXISTS (\r\n      SELECT 1 FROM unnest(xpath(\r\n        \u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[\r\n          gmd:type/gmd:MD_KeywordTypeCode[@codeListValue\u003d\"theme\"]\r\n          and gmd:thesaurusName//gco:CharacterString[contains(text(), \"SeaDataNet Parameter Discovery Vocabulary\")]\r\n        ]/gmd:keyword/gco:CharacterString/text()\u0027,\r\n        mx.data_xml,\r\n        \u0027{{gmd,http://www.isotc211.org/2005/gmd},\r\n          {gco,http://www.isotc211.org/2005/gco},\r\n          {xlink,http://www.w3.org/1999/xlink}}\u0027::text[]\r\n      ))\r\n    ) THEN \u0027CharacterString\u0027\r\n\r\n    \r\n  END\r\n) AS \"Keyword Type\",\r\n\r\n\r\n\r\n-- Added in information aboutthe records status\r\n-- identify if they already went through validaton process  \r\n  (CASE\r\n\t        WHEN EXISTS (\r\n\t            SELECT 1\r\n\t            FROM validation\r\n\t            WHERE metadataid \u003d mx.id AND required \u003d \u0027true\u0027 AND failed !\u003d 0\r\n\t        ) THEN \u0027Invalid\u0027\r\n\t        WHEN EXISTS (\r\n\t            SELECT 1\r\n\t            FROM validation\r\n\t            WHERE metadataid \u003d mx.id AND required \u003d \u0027true\u0027 AND failed \u003d 0\r\n\t        ) THEN \u0027Valid\u0027\r\n\t        ELSE \u0027Unknown\u0027\r\n\t    END\r\n\t) AS \"Validation Status\",\r\n\r\n--  to identify if they are relevant to MEDIN or data.gov as will be prioroty to fix before harvest \t\r\n\t(CASE\r\n\t        WHEN EXISTS (SELECT 1 FROM operationallowed oa WHERE oa.metadataid \u003d mx.id AND oa.groupid \u003d 102 AND oa.operationid \u003d 0) AND EXISTS (SELECT 1 FROM operationallowed oa2 WHERE oa2.metadataid \u003d mx.id AND oa2.groupid \u003d 103 AND oa2.operationid \u003d 0) THEN \u0027GEMINI \u0026 MEDIN\u0027\r\n\t        WHEN EXISTS (SELECT 1 FROM operationallowed oa WHERE oa.metadataid \u003d mx.id AND oa.groupid \u003d 102 AND oa.operationid \u003d 0) THEN \u0027GEMINI\u0027\r\n\t        WHEN EXISTS (SELECT 1 FROM operationallowed oa WHERE oa.metadataid \u003d mx.id AND oa.groupid \u003d 103 AND oa.operationid \u003d 0) THEN \u0027MEDIN\u0027\r\n\t        ELSE \u0027-\u0027\r\n\t    END \r\n\t) AS \"Groups Available in (GEMINI / MEDIN)\",\r\n\r\n\r\n-- Add in section as to whether in public view\r\n(\r\n    CASE WHEN EXISTS (\r\n      SELECT \r\n        1 \r\n      FROM \r\n        operationallowed oa \r\n      WHERE \r\n        oa.metadataid \u003d mx.id \r\n        AND oa.groupid \u003d 1 \r\n        AND oa.operationid \u003d 0\r\n    ) THEN \u0027Public record\u0027 ELSE \u0027Private record\u0027 END\r\n  ) AS \"Record in Public view\" \r\n\r\nFROM custom.metadata_xml mx\r\nJOIN (\r\n    SELECT \r\n      DISTINCT ON (uuid) uuid, \r\n      changedate, \r\n      userid \r\n    FROM \r\n      metadatastatus \r\n    ORDER BY \r\n      uuid, \r\n      changedate DESC, \r\n      userid\r\n  ) ms ON mx.uuid \u003d ms.uuid \r\n  JOIN users u ON ms.userid \u003d u.id \r\n\r\nWHERE (mx.istemplate \u003d \u0027n\u0027 OR mx.istemplate \u003d \u0027y\u0027)\r\n\r\n\r\n\r\n--enable this if you want  to select a specific file\r\n--AND mx.uuid \u003d \u0027${NRW File identifier}\u0027 \r\n\r\n--N.B. If the keywords are not returning this is bacause a change in the past needs to be enacted, by going into edit mode on the records.  once saved, even if no change the keywords then appear.  How do we enact a save on all records to comit any changes from old bulk or migrated edit\r\nLIMIT 4000;",
      "user": "anonymous",
      "dateUpdated": "2026-02-26 15:20:43.878",
