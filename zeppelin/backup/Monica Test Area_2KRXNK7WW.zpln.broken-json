    {
      "title": "Returns Astract, LIneage \u0026 Additinal Information in English",
      "text": "-- This report is a COPY of our base reference report, BUT with Englsi Abstract, English LIneage \u0026 English Additional Information Added. MJ 24-11-2025.\n\nSELECT \n  mx.id AS \"Database ID\", \n  mx.uuid AS \"NRW File identifier\", \n  mx.createdate, \n  mx.popularity, \n  --  mx.rating,  \n  (\n    CASE WHEN EXISTS (\n      SELECT \n        1 \n      FROM \n        validation \n      WHERE \n        metadataid \u003d mx.id \n        AND required \u003d \u0027true\u0027 \n        AND failed !\u003d 0\n    ) THEN \u0027Invalid\u0027 WHEN EXISTS (\n      SELECT \n        1 \n      FROM \n        validation \n      WHERE \n        metadataid \u003d mx.id \n        AND required \u003d \u0027true\u0027 \n        AND failed \u003d 0\n    ) THEN \u0027Valid\u0027 ELSE \u0027Unassessed\u0027 END\n  ) AS \"Validation Status\", \n  (\n    CASE WHEN mx.id IN (\n      SELECT \n        metadataid \n      FROM \n        operationallowed \n      WHERE \n        operationid \u003d 2 \n        AND groupid \u003d 107\n    ) THEN \u0027Editable\u0027 ELSE \u0027Non-editable\u0027 END\n  ) AS \"Edit Status\", \n  \n  /*X query for arrays*/\n  array_to_string(\n    xpath(\n      \u0027/gmd:MD_Metadata/gmd:identificationInfo/gmd:MD_DataIdentification/gmd:citation/gmd:CI_Citation/gmd:title/gco:CharacterString/text()\u0027 :: text, \n      mx.data_xml, \u0027{{gco,http://www.isotc211.org/2005/gco},{gmd,http://www.isotc211.org/2005/gmd}}\u0027 :: text[]\n    ), \n    \u0027-\u0027 :: text\n  ) AS \"Title\", \n  array_to_string(\n    xpath(\n      \u0027/gmd:MD_Metadata/gmd:identificationInfo/gmd:MD_DataIdentification/gmd:citation/gmd:CI_Citation/gmd:title/gmd:PT_FreeText//gmd:textGroup[2]/gmd:LocalisedCharacterString/text()\u0027 :: text, \n      mx.data_xml, \u0027{{gco,http://www.isotc211.org/2005/gco},{gmd,http://www.isotc211.org/2005/gmd}}\u0027 :: text[2]\n    ), \n    \u0027-\u0027 :: text\n  ) AS \"TitleCY\", \n  array_to_string(\n    xpath(\n      \u0027/gmd:MD_Metadata/gmd:fileIdentifier/gco:CharacterString/text()\u0027 :: text, \n      mx.data_xml, \u0027{{gco,http://www.isotc211.org/2005/gco},{gmd,http://www.isotc211.org/2005/gmd}}\u0027 :: text[]\n    ), \n    \u0027-\u0027 :: text\n  ) AS \"Resource Identifier\", \n    \narray_to_string(\n    xpath(\n      \u0027/gmd:MD_Metadata/gmd:identificationInfo/gmd:MD_DataIdentification/gmd:abstract/gmd:PT_FreeText/gmd:textGroup/gmd:LocalisedCharacterString/text()\u0027 :: text, \n      mx.data_xml, \u0027{{gco,http://www.isotc211.org/2005/gco},{gmd,http://www.isotc211.org/2005/gmd}}\u0027 :: text[]\n    ), \n    \u0027-\u0027 :: text\n) AS \"Abstract\",\narray_to_string(\n    xpath(\n      \u0027/gmd:MD_Metadata/gmd:dataQualityInfo/gmd:DQ_DataQuality/gmd:lineage/gmd:LI_Lineage/gmd:statement/gco:CharacterString/text()\u0027 :: text,\n      mx.data_xml,\n      \u0027{{gco,http://www.isotc211.org/2005/gco},{gmd,http://www.isotc211.org/2005/gmd}}\u0027 :: text[]\n    ),\n    \u0027-\u0027 :: text\n) AS \"Lineage\",\narray_to_string(\n    xpath(\n      \u0027/gmd:MD_Metadata/gmd:identificationInfo/gmd:MD_DataIdentification/gmd:supplementalInformation/gco:CharacterString/text()\u0027 :: text,\n      mx.data_xml,\n      \u0027{{gco,http://www.isotc211.org/2005/gco},{gmd,http://www.isotc211.org/2005/gmd}}\u0027 :: text[]\n    ),\n    \u0027-\u0027 :: text\n) AS \"Additional_Information\",\n    array_to_string(\n    xpath(\n      \u0027/gmd:MD_Metadata/gmd:contentInfo/nrw:MD_ContentInfo/nrw:internalInfo/nrw:MD_InternalInfo/nrw:internalLocationInfo/gco:CharacterString/text()\u0027 :: text, \n      mx.data_xml, \u0027{{gco,http://www.isotc211.org/2005/gco},{gmd,http://www.isotc211.org/2005/gmd},{nrw,http://naturalresources.wales/nrw}}\u0027 :: text[]\n    ), \n    \u0027-\u0027 :: text\n  ) AS \"NRW Internal Location\", \n   array_to_string(\n    xpath(\n      \u0027/gmd:MD_Metadata/gmd:contentInfo/nrw:MD_ContentInfo/nrw:internalInfo/nrw:MD_InternalInfo/nrw:internalContactInfo/gco:CharacterString/text()\u0027 :: text, \n      mx.data_xml, \u0027{{gco,http://www.isotc211.org/2005/gco},{gmd,http://www.isotc211.org/2005/gmd},{nrw,http://naturalresources.wales/nrw}}\u0027 :: text[]\n    ), \n    \u0027-\u0027 :: text\n  ) AS \"NRW Internal Custodian\", \n  array_to_string(\n    xpath(\n      \u0027/gmd:MD_Metadata/gmd:identificationInfo/gmd:MD_DataIdentification/gmd:pointOfContact[gmd:CI_ResponsibleParty/gmd:role/gmd:CI_RoleCode/@codeListValue \u003d \"owner\"]/gmd:CI_ResponsibleParty/gmd:organisationName/gco:CharacterString/text()\u0027 :: text, \n      mx.data_xml, \u0027{{gco,http://www.isotc211.org/2005/gco},{gmd,http://www.isotc211.org/2005/gmd}}\u0027 :: text[]\n    ), \n    \u0027-\u0027 :: text\n  ) AS \"Owner organisation\", \n  array_to_string(\n    xpath(\n      \u0027/gmd:MD_Metadata/gmd:identificationInfo/gmd:MD_DataIdentification/gmd:resourceConstraints/gmd:MD_LegalConstraints[gmd:useConstraints]/gmd:otherConstraints/gmx:Anchor/text()\u0027 :: text, \n      mx.data_xml, \u0027{{gmx,http://www.isotc211.org/2005/gmx},{gmd,http://www.isotc211.org/2005/gmd}}\u0027 :: text[]\n    ), \n    \u0027-\u0027 :: text\n  ) AS \"Licence\", \n  array_to_string(\n    xpath(\n      \u0027/gmd:MD_Metadata/gmd:identificationInfo/gmd:MD_DataIdentification/gmd:citation/gmd:CI_Citation/gmd:date/gmd:CI_Date/gmd:date/gco:Date/text()\u0027 :: text, \n      mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gco,http://www.isotc211.org/2005/gco}}\u0027 :: text[]\n    ), \n    \u0027-\u0027 :: text\n  ) AS \"date\", \n  array_to_string(\n    xpath(\n      \u0027/gmd:MD_Metadata/gmd:identificationInfo/gmd:MD_DataIdentification/gmd:citation/gmd:CI_Citation/gmd:date/gmd:CI_Date/gmd:dateType/gmd:CI_DateTypeCode/@codeListValue\u0027 :: text, \n      mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gco,http://www.isotc211.org/2005/gco}}\u0027 :: text[0]\n    ), \n    \u0027-\u0027 :: text\n  ) AS \"datetype\", \n  --    array_to_string(xpath(\u0027/gmd:MD_Metadata/gmd:distributionInfo/gmd:MD_Distribution/gmd:transferOptions/gmd:MD_DigitalTransferOptions/gmd:onLine/gmd:CI_OnlineResource/gmd:linkage/gmd:URL\u0027::text, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gco,http://www.isotc211.org/2005/gco/text()}}\u0027::text[0]), \u0027-\u0027::text) AS \"RL\",  \n  \n  /*x query case for resource locators */\n  -- get wms into 1 attribute\n  case when array_to_string(\n    xpath(\n      \u0027/gmd:MD_Metadata/gmd:distributionInfo/gmd:MD_Distribution/gmd:transferOptions[1]/gmd:MD_DigitalTransferOptions/gmd:onLine/gmd:CI_OnlineResource/gmd:protocol/gco:CharacterString/text()\u0027 :: text, \n      mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gco,http://www.isotc211.org/2005/gco}}\u0027 :: text[]\n    ), \n    \u0027-\u0027 :: text\n  ) \u003d \u0027OGC:WMS\u0027 then array_to_string(\n    xpath(\n      \u0027/gmd:MD_Metadata/gmd:distributionInfo/gmd:MD_Distribution/gmd:transferOptions[1]/gmd:MD_DigitalTransferOptions/gmd:onLine/gmd:CI_OnlineResource/gmd:linkage/gmd:URL/text()\u0027 :: text, \n      mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gco,http://www.isotc211.org/2005/gco/text()}}\u0027 :: text[]\n    ), \n    \u0027-\u0027 :: text\n  ) when array_to_string(\n    xpath(\n      \u0027/gmd:MD_Metadata/gmd:distributionInfo/gmd:MD_Distribution/gmd:transferOptions[2]/gmd:MD_DigitalTransferOptions/gmd:onLine/gmd:CI_OnlineResource/gmd:protocol/gco:CharacterString/text()\u0027 :: text, \n      mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gco,http://www.isotc211.org/2005/gco}}\u0027 :: text[]\n    ), \n    \u0027-\u0027 :: text\n  ) \u003d \u0027OGC:WMS\u0027 then array_to_string(\n    xpath(\n      \u0027/gmd:MD_Metadata/gmd:distributionInfo/gmd:MD_Distribution/gmd:transferOptions[2]/gmd:MD_DigitalTransferOptions/gmd:onLine/gmd:CI_OnlineResource/gmd:linkage/gmd:URL/text()\u0027 :: text, \n      mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gco,http://www.isotc211.org/2005/gco/text()}}\u0027 :: text[]\n    ), \n    \u0027-\u0027 :: text\n  ) else \u0027null\u0027 end as \"WMS\", \n  -- get url into 1 attribute\n  case when array_to_string(\n    xpath(\n      \u0027/gmd:MD_Metadata/gmd:distributionInfo/gmd:MD_Distribution/gmd:transferOptions[1]/gmd:MD_DigitalTransferOptions/gmd:onLine/gmd:CI_OnlineResource/gmd:protocol/gco:CharacterString/text()\u0027 :: text, \n      mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gco,http://www.isotc211.org/2005/gco}}\u0027 :: text[]\n    ), \n    \u0027-\u0027 :: text\n  ) \u003d \u0027WWW:LINK-1.0-http--link\u0027 then array_to_string(\n    xpath(\n      \u0027/gmd:MD_Metadata/gmd:distributionInfo/gmd:MD_Distribution/gmd:transferOptions[1]/gmd:MD_DigitalTransferOptions/gmd:onLine/gmd:CI_OnlineResource/gmd:linkage/gmd:URL/text()\u0027 :: text, \n      mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gco,http://www.isotc211.org/2005/gco/text()}}\u0027 :: text[]\n    ), \n    \u0027-\u0027 :: text\n  ) when array_to_string(\n    xpath(\n      \u0027/gmd:MD_Metadata/gmd:distributionInfo/gmd:MD_Distribution/gmd:transferOptions[2]/gmd:MD_DigitalTransferOptions/gmd:onLine/gmd:CI_OnlineResource/gmd:protocol/gco:CharacterString/text()\u0027 :: text, \n      mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gco,http://www.isotc211.org/2005/gco}}\u0027 :: text[]\n    ), \n    \u0027-\u0027 :: text\n  ) \u003d \u0027WWW:LINK-1.0-http--link\u0027 then array_to_string(\n    xpath(\n      \u0027/gmd:MD_Metadata/gmd:distributionInfo/gmd:MD_Distribution/gmd:transferOptions[2]/gmd:MD_DigitalTransferOptions/gmd:onLine/gmd:CI_OnlineResource/gmd:linkage/gmd:URL/text()\u0027 :: text, \n      mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gco,http://www.isotc211.org/2005/gco/text()}}\u0027 :: text[]\n    ), \n    \u0027-\u0027 :: text\n  ) else \u0027null\u0027 end as \"url\", \n  \n  /*Other */\n  ms.changedate AS \"Date Last Edited\", \n  u.name || \u0027 \u0027 || u.surname AS \"Last Editor Name\", \n  (\n    CASE WHEN EXISTS (\n      SELECT \n        1 \n      FROM \n        operationallowed oa \n      WHERE \n        oa.metadataid \u003d mx.id \n        AND oa.groupid \u003d 102 \n        AND oa.operationid \u003d 0\n    ) \n    AND EXISTS (\n      SELECT \n        1 \n      FROM \n        operationallowed oa2 \n      WHERE \n        oa2.metadataid \u003d mx.id \n        AND oa2.groupid \u003d 103 \n        AND oa2.operationid \u003d 0\n    ) THEN \u0027GEMINI \u0026 MEDIN\u0027 WHEN EXISTS (\n      SELECT \n        1 \n      FROM \n        operationallowed oa \n      WHERE \n        oa.metadataid \u003d mx.id \n        AND oa.groupid \u003d 102 \n        AND oa.operationid \u003d 0\n    ) THEN \u0027GEMINI\u0027 WHEN EXISTS (\n      SELECT \n        1 \n      FROM \n        operationallowed oa \n      WHERE \n        oa.metadataid \u003d mx.id \n        AND oa.groupid \u003d 103 \n        AND oa.operationid \u003d 0\n    ) THEN \u0027MEDIN\u0027 ELSE \u0027-\u0027 END\n  ) AS \"Groups Available in (GEMINI / MEDIN)\", \n  (\n    CASE WHEN EXISTS (\n      SELECT \n        1 \n      FROM \n        operationallowed oa \n      WHERE \n        oa.metadataid \u003d mx.id \n        AND oa.groupid \u003d 1 \n        AND oa.operationid \u003d 0\n    ) THEN \u0027Public record\u0027 ELSE \u0027Private record\u0027 END\n  ) AS \"Record in Public view\" \nFROM \n  custom.metadata_xml mx \n  JOIN (\n    SELECT \n      DISTINCT ON (uuid) uuid, \n      changedate, \n      userid \n    FROM \n      metadatastatus \n    ORDER BY \n      uuid, \n      changedate DESC, \n      userid\n  ) ms ON mx.uuid \u003d ms.uuid \n  JOIN users u ON ms.userid \u003d u.id \nWHERE \n  (\n    mx.istemplate \u003d \u0027n\u0027 \n    OR mx.istemplate \u003d \u0027y\u0027\n  ) \n  \n--AND mx.uuid \u003d \u0027${NRW File identifier}\u0027 \nLIMIT 4000;",
      "user": "monica.jones_reporting",
