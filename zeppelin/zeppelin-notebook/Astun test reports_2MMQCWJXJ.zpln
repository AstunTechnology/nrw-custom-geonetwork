{
  "paragraphs": [
    {
      "title": "MEDIN keywords for batch update",
      "text": "SELECT \n  kw AS \"Unique SeaDataNet Keywords\",\n  COUNT(*) AS \"Occurrence Count\"\nFROM (\n  SELECT \n    unnest(xpath(\n      -- OPTION A: ALL KEYWORDS (Anchor + String + Localised)\n      --\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[descendant-or-self::*[contains(text(), \"SeaDataNet Parameter Discovery Vocabulary\")]]/gmd:keyword/descendant-or-self::*[self::gmx:Anchor or self::gco:CharacterString or self::gmd:LocalisedCharacterString]/text()\u0027,\n      \n      -- OPTION B: CHARACTER STRINGS ONLY (The \"To-Do\" list)\n       \u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[descendant-or-self::*[contains(text(), \"SeaDataNet Parameter Discovery Vocabulary\")]]/gmd:keyword/gco:CharacterString/text()\u0027,\n      \n      -- OPTION C: ANCHORS ONLY (The \"Done\" list)\n      -- \u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[descendant-or-self::*[contains(text(), \"SeaDataNet Parameter Discovery Vocabulary\")]]/gmd:keyword/gmx:Anchor/text()\u0027,\n\n      mx.data_xml::xml,\n      \u0027{{gmd,http://www.isotc211.org/2005/gmd},\n        {gmx,http://www.isotc211.org/2005/gmx},\n        {gco,http://www.isotc211.org/2005/gco}}\u0027::text[]\n    ))::text AS kw\n  FROM custom.metadata_xml mx\n  WHERE (mx.istemplate \u003d \u0027n\u0027 OR mx.istemplate \u003d \u0027y\u0027)\n  AND (xpath(\u0027boolean(//gmd:MD_Keywords[descendant::*[contains(text(), \"SeaDataNet Parameter Discovery Vocabulary\")]]/gmd:keyword)\u0027, \n        mx.data_xml::xml, \n        \u0027{{gmd,http://www.isotc211.org/2005/gmd}}\u0027::text[]))[1]::text \u003d \u0027true\u0027\n) sub\nGROUP BY kw\nORDER BY \"Occurrence Count\" DESC;",
      "user": "admin",
      "dateUpdated": "2026-03-03 17:30:55.103",
      "progress": 0,
      "config": {
        "editorSetting": {
          "language": "sql",
          "editOnDblClick": false,
