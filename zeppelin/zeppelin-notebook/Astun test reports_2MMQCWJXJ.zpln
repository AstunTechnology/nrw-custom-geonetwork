    {
      "title": "Report on all MEDIN keywords type",
      "text": "WITH RawReport AS (\n  SELECT\n    mx.uuid AS \"NRW File identifier\",\n    mx.createdate AS \"Date Created\",\n    ms.changedate AS \"Date Last Edited\", \n    u.name || \u0027 \u0027 || u.surname AS \"Last Editor Name\",\n\n    -- Title Extraction\n    array_to_string(\n      xpath(\u0027/gmd:MD_Metadata/gmd:identificationInfo/gmd:MD_DataIdentification/gmd:citation/gmd:CI_Citation/gmd:title/gco:CharacterString/text()\u0027::text, \n            mx.data_xml, \n            \u0027{{gco,http://www.isotc211.org/2005/gco},{gmd,http://www.isotc211.org/2005/gmd}}\u0027::text[]), \n      \u0027-\u0027::text\n    ) AS \"Title\",\n\n    -- Keyword Extraction: Combines both Anchor and CharacterString values for the SeaDataNet thesaurus\n    COALESCE(\n      NULLIF(\n        array_to_string(\n          array_remove(\n            ARRAY[\n              NULLIF(array_to_string(\n                xpath(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[gmd:thesaurusName//descendant-or-self::*[contains(text(), \"SeaDataNet Parameter Discovery Vocabulary\")]]/gmd:keyword/gmx:Anchor/text()\u0027::text,\n                      mx.data_xml,\n                      \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gmx,http://www.isotc211.org/2005/gmx},{xlink,http://www.w3.org/1999/xlink}}\u0027::text[]), \u0027, \u0027), \u0027\u0027),\n              NULLIF(array_to_string(\n                xpath(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[gmd:thesaurusName//descendant-or-self::*[contains(text(), \"SeaDataNet Parameter Discovery Vocabulary\")]]/gmd:keyword/gco:CharacterString/text()\u0027::text,\n                      mx.data_xml,\n                      \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gco,http://www.isotc211.org/2005/gco}}\u0027::text[]), \u0027, \u0027), \u0027\u0027)\n            ], \u0027\u0027\n          ), \u0027, \u0027\n        ), \u0027\u0027\n      ), \u0027Missing\u0027\n    ) AS \"MEDIN/SeaDataNet Keywords\",\n\n    -- Detects if the SeaDataNet keywords are stored as Anchors, CharacterStrings, or a Mix\n    (CASE\n      WHEN EXISTS (SELECT 1 FROM unnest(xpath(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[gmd:thesaurusName//descendant-or-self::*[contains(text(), \"SeaDataNet Parameter Discovery Vocabulary\")]]/gmd:keyword/gmx:Anchor\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gmx,http://www.isotc211.org/2005/gmx}}\u0027::text[])))\n       AND EXISTS (SELECT 1 FROM unnest(xpath(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[gmd:thesaurusName//descendant-or-self::*[contains(text(), \"SeaDataNet Parameter Discovery Vocabulary\")]]/gmd:keyword/gco:CharacterString\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gco,http://www.isotc211.org/2005/gco}}\u0027::text[])))\n      THEN \u0027MIXED (Anchor \u0026 String)\u0027\n      \n      WHEN EXISTS (SELECT 1 FROM unnest(xpath(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[gmd:thesaurusName//descendant-or-self::*[contains(text(), \"SeaDataNet Parameter Discovery Vocabulary\")]]/gmd:keyword/gmx:Anchor\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gmx,http://www.isotc211.org/2005/gmx}}\u0027::text[])))\n      THEN \u0027Anchor Only\u0027\n      \n      WHEN EXISTS (SELECT 1 FROM unnest(xpath(\u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[gmd:thesaurusName//descendant-or-self::*[contains(text(), \"SeaDataNet Parameter Discovery Vocabulary\")]]/gmd:keyword/gco:CharacterString\u0027, mx.data_xml, \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gco,http://www.isotc211.org/2005/gco}}\u0027::text[])))\n      THEN \u0027CharacterString Only\u0027\n      \n      ELSE \u0027None\u0027\n    END) AS \"Keyword Type\",\n\n    -- Validation Status check\n    (CASE\n        WHEN EXISTS (SELECT 1 FROM validation WHERE metadataid \u003d mx.id AND required \u003d \u0027true\u0027 AND failed !\u003d 0) THEN \u0027Invalid\u0027\n        WHEN EXISTS (SELECT 1 FROM validation WHERE metadataid \u003d mx.id AND required \u003d \u0027true\u0027 AND failed \u003d 0) THEN \u0027Valid\u0027\n        ELSE \u0027Unknown\u0027\n    END) AS \"Validation Status\",\n\n    -- Group checking (GEMINI / MEDIN)\n    (CASE\n        WHEN EXISTS (SELECT 1 FROM operationallowed oa WHERE oa.metadataid \u003d mx.id AND oa.groupid \u003d 102 AND oa.operationid \u003d 0) AND EXISTS (SELECT 1 FROM operationallowed oa2 WHERE oa2.metadataid \u003d mx.id AND oa2.groupid \u003d 103 AND oa2.operationid \u003d 0) THEN \u0027GEMINI \u0026 MEDIN\u0027\n        WHEN EXISTS (SELECT 1 FROM operationallowed oa WHERE oa.metadataid \u003d mx.id AND oa.groupid \u003d 102 AND oa.operationid \u003d 0) THEN \u0027GEMINI\u0027\n        WHEN EXISTS (SELECT 1 FROM operationallowed oa WHERE oa.metadataid \u003d mx.id AND oa.groupid \u003d 103 AND oa.operationid \u003d 0) THEN \u0027MEDIN\u0027\n        ELSE \u0027-\u0027\n    END) AS \"Groups Available\",\n\n    -- Public vs Private check\n    (CASE WHEN EXISTS (SELECT 1 FROM operationallowed oa WHERE oa.metadataid \u003d mx.id AND oa.groupid \u003d 1 AND oa.operationid \u003d 0) THEN \u0027Public record\u0027 ELSE \u0027Private record\u0027 END) AS \"Record in Public view\" \n\n  FROM custom.metadata_xml mx\n  JOIN (\n      SELECT DISTINCT ON (uuid) uuid, changedate, userid \n      FROM metadatastatus \n      ORDER BY uuid, changedate DESC, userid\n    ) ms ON mx.uuid \u003d ms.uuid \n  JOIN users u ON ms.userid \u003d u.id \n  WHERE (mx.istemplate \u003d \u0027n\u0027 OR mx.istemplate \u003d \u0027y\u0027)\n)\n-- FINAL FILTER: Only returns records that have a MEDIN/SeaDataNet keyword entry\nSELECT * FROM RawReport \nWHERE \"MEDIN/SeaDataNet Keywords\" !\u003d \u0027Missing\u0027 \n  AND \"Keyword Type\" !\u003d \u0027None\u0027\nORDER BY \"Keyword Type\" ASC, \"Date Last Edited\" DESC\nLIMIT 4000;",
      "user": "anonymous",
      "dateUpdated": "2026-03-03 17:31:13.175",
      "progress": 0,
      "config": {
        "editorSetting": {
          "language": "sql",
          "editOnDblClick": false,
          "completionSupport": true
        },
