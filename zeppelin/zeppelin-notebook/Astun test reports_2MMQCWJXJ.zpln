    },
    {
      "title": "Records to fix for a given MEDIN keyword",
      "text": "WITH MetadataReport AS (\n  SELECT\n    mx.uuid AS \"NRW File identifier\",\n    -- Record Title Extraction\n    array_to_string(\n      xpath(\u0027/gmd:MD_Metadata/gmd:identificationInfo//gmd:citation/gmd:CI_Citation/gmd:title/descendant-or-self::*[self::gco:CharacterString]/text()\u0027, \n            mx.data_xml::xml, \n            \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gco,http://www.isotc211.org/2005/gco}}\u0027::text[]), \n      \u0027-\u0027\n    ) AS \"Title\",\n\n    -- Determine if the SDN thesaurus title in this record uses PT_FreeText\n    CASE \n      WHEN (xpath(\u0027boolean(//gmd:MD_Keywords[descendant::*[contains(text(), \"SeaDataNet Parameter Discovery Vocabulary\")]]/gmd:thesaurusName/gmd:CI_Citation/gmd:title[@xsi:type\u003d\"gmd:PT_FreeText_PropertyType\"])\u0027, \n            mx.data_xml::xml, \n            \u0027{{gmd,http://www.isotc211.org/2005/gmd},{xsi,http://www.w3.org/2001/XMLSchema-instance}}\u0027::text[]))[1]::text \u003d \u0027true\u0027\n      THEN \u0027PT_FreeText (Complex)\u0027\n      ELSE \u0027Simple Title\u0027\n    END AS \"Thesaurus Structure\",\n\n    -- Restricted unnest to only capture gco:CharacterString (To-Do list)\n    unnest(xpath(\n      \u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[\n        descendant-or-self::*[contains(text(), \"SeaDataNet Parameter Discovery Vocabulary\")]\n      ]/gmd:keyword/gco:CharacterString/text()\u0027,\n      mx.data_xml::xml,\n      \u0027{{gmd,http://www.isotc211.org/2005/gmd},{gmx,http://www.isotc211.org/2005/gmx},{gco,http://www.isotc211.org/2005/gco}}\u0027::text[]\n    ))::text AS \"Keyword\"\n\n  FROM custom.metadata_xml mx\n  WHERE (mx.istemplate \u003d \u0027n\u0027 OR mx.istemplate \u003d \u0027y\u0027)\n  AND mx.data_xml::text ILIKE \u0027%\u0027 || \u0027${MEDIN keyword}\u0027 || \u0027%\u0027\n)\nSELECT \n  \"NRW File identifier\",\n  \"Title\",\n  \"Keyword\",\n  \"Thesaurus Structure\",\n  \u0027CharacterString (To-Do)\u0027 AS \"Format\",\n  COUNT(*) OVER(PARTITION BY \"NRW File identifier\") AS \"Occurrences in this File\"\nFROM MetadataReport\nWHERE \"Keyword\" \u003d \u0027${MEDIN keyword}\u0027\nORDER BY \"Thesaurus Structure\" DESC, \"Occurrences in this File\" DESC;",
      "user": "admin",
      "dateUpdated": "2026-03-03 17:30:57.655",
      "progress": 0,
      "config": {
        "editorSetting": {
          "language": "sql",
          "editOnDblClick": false,
