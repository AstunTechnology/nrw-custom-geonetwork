u003cgmd:PT_Locale id\u003d\"EN\"\u003e       \u003cgmd:languageCode\u003e         \u003cgmd:LanguageCode codeList\u003d\"http://www.loc.gov/standards/iso639-2/\" codeListValue\u003d\"eng\" /\u003e       \u003c/gmd:languageCode\u003e       \u003cgmd:characterEncoding\u003e         \u003cgmd:MD_CharacterSetCode codeList\u003d\"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#MD_CharacterSetCode\" codeListValue\u003d\"utf8\" /\u003e       \u003c/gmd:characterEncoding\u003e     \u003c/gmd:PT_Locale\u003e   \u003c/gmd:locale\u003e   \u003cgmd:referenceSystemInfo\u003e     \u003cgmd:MD_ReferenceSystem\u003e       \u003cgmd:referenceSystemIdentifier\u003e         \u003cgmd:RS_Identifier\u003e           \u003cgmd:code\u003e             \u003cgmx:Anchor xlink:href\u003d\"http://www.opengis.net/def/crs/EPSG/0/4326\"\u003eLatitude and Longitude (EPSG::4326)\u003c/gmx:Anchor\u003e           \u003c/gmd:code\u003e         \u003c/gmd:RS_Identifier\u003e       \u003c/gmd:referenceSystemIdentifier\u003e     \u003c/gmd:MD_ReferenceSystem\u003e   \u003c/gmd:referenceSystemInfo\u003e   \u003cgmd:identificationInfo\u003e     \u003cgmd:MD_DataIdentification\u003e       \u003cgmd:citation\u003e         \u003cgmd:CI_Citation\u003e           \u003cgmd:title xsi:type\u003d\"gmd:PT_FreeText_PropertyType\"\u003e             \u003cgco:CharacterString\u003eRisso\u0027s Dolphin (Grampus griseus) Surveys Conducted in North Wales (2012) (3rd Party Data)\u003c/gco:CharacterString\u003e             \u003cgmd:PT_FreeText\u003e               \u003cgmd:textGroup\u003e                 \u003cgmd:LocalisedCharacterString locale\u003d\"#EN\"\u003eRisso\u0027s Dolphin (Grampus griseus) Surveys Conducted in North Wales (2012) (3rd Party Data)\u003c/gmd:LocalisedCharacterString\u003e               \u003c/gmd:textGroup\u003e             \u003c/gmd:PT_FreeText\u003e           \u003c/gmd:title\u003e           \u003cgmd:alternateTitle\u003e             \u003cgco:CharacterString\u003eDolffin Risso yng Ngogledd Cymru, 2012\u003c/gco:CharacterString\u003e           \u003c/gmd:alternateTitle\u003e           \u003cgmd:alternateTitle\u003e             \u003cgco:CharacterString\u003eLand and vessel sightings of Risso\u0027s dolphin and other cetacean species around Bardsey Island\u003c/gco:CharacterString\u003e           \u003c/gmd:alternateTitle\u003e           \u003cgmd:date\u003e             \u003cgmd:CI_Date\u003e               \u003cgmd:date\u003e                 \u003cgco:Date\u003e2013-03-31\u003c/gco:Date\u003e               \u003c/gmd:date\u003e               \u003cgmd:dateType\u003e                 \u003cgmd:CI_DateTypeCode codeList\u003d\"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#CI_DateTypeCode\" codeListValue\u003d\"publication\" /\u003e               \u003c/gmd:dateType\u003e             \u003c/gmd:CI_Date\u003e           \u003c/gmd:date\u003e           \u003cgmd:identifier\u003e             \u003cgmd:MD_Identifier\u003e               \u003cgmd:code\u003e                 \u003cgco:CharacterString\u003eEXT_DS115256\u003c/gco:CharacterString\u003e               \u003c/gmd:code\u003e             \u003c/gmd:MD_Identifier\u003e           \u003c/gmd:identifier\u003e         \u003c/gmd:CI_Citation\u003e       \u003c/gmd:citation\u003e       \u003cgmd:abstract xsi:type\u003d\"gmd:PT_FreeText_PropertyType\"\u003e         \u003cgco:CharacterString\u003eA Welsh Government (ERF) grant funded project carried out by Whale and Dolphin Conservation (WDC).  WDC have studies cetaceans in the area around Ynys Enlli, Bardsey for 13 years.  The long-term dataset helps describe the occurrence, distribution, site fidelity, habitat use and behaviour of small cetaceans.  The data described here relates to the 2012 annual survey.  The collated information will help provide the basis for future surveys, comparisons to determine population densities for small cetacean species and also provide information for local conservation and management plans.  The seas around Ynys Enlli/Bardsey Island and the sound between Ynys Enlli and the mainland.\u003c/gco:CharacterString\u003e         \u003cgmd:PT_FreeText\u003e           \u003cgmd:textGroup\u003e             \u003cgmd:LocalisedCharacterString locale\u003d\"#EN\"\u003eA Welsh Government (ERF) grant funded project carried out by Whale and Dolphin Conservation (WDC).  WDC have studies cetaceans in the area around Ynys Enlli, Bardsey for 13 years.  The long-term dataset helps describe the occurrence, distribution, site fidelity, habitat use and behaviour of small cetaceans.  The data described here relates to the 2012 annual survey.  The collated information will help provide the basis for future surveys, comparisons to determine population densities for small cetacean species and also provide information for local conservation and management plans.  The seas around Ynys Enlli/Bardsey Island and the sound between Ynys Enlli and the mainland.\u003c/gmd:LocalisedCharacterString\u003e           \u003c/gmd:textGroup\u003e         \u003c/gmd:PT_FreeText\u003e       \u003c/gmd:abstract\u003e       \u003cgmd:pointOfContact\u003e         \u003cgmd:CI_ResponsibleParty\u003e           \u003cgmd:organisationName\u003e             \u003cgco:CharacterString\u003eWhale and Dolphin Conservation\u003c/gco:CharacterString\u003e           \u003c/gmd:organisationName\u003e           \u003cgmd:contactInfo\u003e             \u003cgmd:CI_Contact\u003e               \u003cgmd:address\u003e                 \u003cgmd:CI_Address\u003e                   \u003cgmd:deliveryPoint\u003e                     \u003cgco:CharacterString\u003eBrookfield House, 38 St. Paul Street, Chippenham, Wiltshire, SN15 1LJ, UK\u003c/gco:CharacterString\u003e                   \u003c/gmd:deliveryPoint\u003e                   \u003cgmd:electronicMailAddress\u003e                     \u003cgco:CharacterString\u003einfo@wdcs.org\u003c/gco:CharacterString\u003e                   \u003c/gmd:electronicMailAddress\u003e                 