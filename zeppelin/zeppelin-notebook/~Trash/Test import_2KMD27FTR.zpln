      "text": "SELECT \n\tmx.id AS \"Database ID\",\n\tmx.uuid AS \"NRW File identifier\",\n    array_to_string(xpath(\u0027/gmd:MD_Metadata/gmd:identificationInfo/gmd:MD_DataIdentification/gmd:citation/gmd:CI_Citation/gmd:title/gco:CharacterString/text()\u0027::text, mx.data_xml, \u0027{{gco,http://www.isotc211.org/2005/gco},{gmd,http://www.isotc211.org/2005/gmd}}\u0027::text[]), \u0027-\u0027::text) AS \"Title\",\n    array_to_string(xpath(\u0027/gmd:MD_Metadata/gmd:identificationInfo/gmd:MD_DataIdentification/gmd:pointOfContact[gmd:CI_ResponsibleParty/gmd:role/gmd:CI_RoleCode/@codeListValue \u003d \"owner\"]/gmd:CI_ResponsibleParty/gmd:organisationName/gco:CharacterString/text()\u0027::text, mx.data_xml, \u0027{{gco,http://www.isotc211.org/2005/gco},{gmd,http://www.isotc211.org/2005/gmd}}\u0027::text[]), \u0027-\u0027::text) AS \"Owner organisation\"\nFROM\n    custom.metadata_xml mx\nWHERE (mx.istemplate \u003d \u0027n\u0027 OR mx.istemplate \u003d \u0027y\u0027)\n-- LIMIT 50;",
