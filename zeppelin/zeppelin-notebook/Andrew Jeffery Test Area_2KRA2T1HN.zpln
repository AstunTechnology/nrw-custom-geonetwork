{
  "paragraphs": [
    {
      "text": "select\n\nisenabled, lastlogindate, name, surname,\n\ncase\n\nwhen profile \u003d 0 then \u0027admin\u0027\nwhen profile \u003d 1 then \u00271\u0027\nwhen profile \u003d 2 then \u0027Reviewer\u0027\nwhen profile \u003d 3 then \u0027Editor\u0027\nwhen profile \u003d 4 then \u0027User\u0027\nelse null\nend as \"Profile\"\n\n from users\n",
