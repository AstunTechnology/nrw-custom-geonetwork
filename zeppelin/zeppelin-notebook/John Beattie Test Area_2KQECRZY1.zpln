    {
      "title": "Export for PowerBI Report - Private Records Clean-up",
      "text": "SELECT\nmx.id AS \"Database ID\",\nmx.uuid AS \"NRW File Identifier\",\nmx.createdate, \n\n\n  array_to_string(\n    xpath(\n      \u0027/gmd:MD_Metadata/gmd:identificationInfo/gmd:MD_DataIdentification/gmd:citation/gmd:CI_Citation/gmd:title/gco:CharacterString/text()\u0027 :: text, \n      mx.data_xml, \u0027{{gco,http://www.isotc211.org/2005/gco},{gmd,http://www.isotc211.org/2005/gmd}}\u0027 :: text[]\n    ), \n    \u0027-\u0027 :: text\n  ) AS \"Title\",\n    array_to_string(\n    xpath(\n      \u0027/gmd:MD_Metadata/gmd:fileIdentifier/gco:CharacterString/text()\u0027 :: text, \n      mx.data_xml, \u0027{{gco,http://www.isotc211.org/2005/gco},{gmd,http://www.isotc211.org/2005/gmd}}\u0027 :: text[]\n    ), \n    \u0027-\u0027 :: text\n  ) AS \"Resource Identifier\",\n   array_to_string(\n    xpath(\n      \u0027/gmd:MD_Metadata/gmd:contentInfo/nrw:MD_ContentInfo/nrw:internalInfo/nrw:MD_InternalInfo/nrw:internalLocationInfo/gco:CharacterString/text()\u0027 :: text, \n      mx.data_xml, \u0027{{gco,http://www.isotc211.org/2005/gco},{gmd,http://www.isotc211.org/2005/gmd},{nrw,http://naturalresources.wales/nrw}}\u0027 :: text[]\n    ), \n    \u0027-\u0027 :: text\n  ) AS \"NRW Internal Location\", \n  array_to_string(\n    xpath(\n      \u0027/gmd:MD_Metadata/gmd:contentInfo/nrw:MD_ContentInfo/nrw:internalInfo/nrw:MD_InternalInfo/nrw:internalContactInfo/gco:CharacterString/text()\u0027 :: text, \n      mx.data_xml, \u0027{{gco,http://www.isotc211.org/2005/gco},{gmd,http://www.isotc211.org/2005/gmd},{nrw,http://naturalresources.wales/nrw}}\u0027 :: text[]\n    ), \n    \u0027-\u0027 :: text\n  ) AS \"NRW Internal Custodian\",\nREPLACE(\n  array_to_string(\n    xpath(\n      \u0027/gmd:MD_Metadata/gmd:identificationInfo/gmd:MD_DataIdentification/gmd:abstract/gco:CharacterString/text()\u0027::text, \n      mx.data_xml, \n      \u0027{{gco,http://www.isotc211.org/2005/gco},{gmd,http://www.isotc211.org/2005/gmd}}\u0027::text[]\n    ), \n    \u0027-\u0027::text\n  ), \n  \u0027,\u0027, \u0027\u0027\n) AS \"AbstractEN\",\n (\n    CASE WHEN EXISTS (\n      SELECT \n        1 \n      FROM \n        operationallowed oa \n      WHERE \n        oa.metadataid \u003d mx.id \n        AND oa.groupid \u003d 1 \n        AND oa.operationid \u003d 0\n    ) THEN \u0027Public record\u0027 ELSE \u0027Private record\u0027 END\n  ) AS \"Record in Public view\" \nFROM \n  custom.metadata_xml mx \n  JOIN (\n    SELECT \n      DISTINCT ON (uuid) uuid, \n      changedate, \n      userid \n    FROM \n      metadatastatus \n    ORDER BY \n      uuid, \n      changedate DESC, \n      userid\n  ) ms ON mx.uuid \u003d ms.uuid \n  JOIN users u ON ms.userid \u003d u.id \nWHERE \n  (\n    mx.istemplate \u003d \u0027n\u0027 \n    OR mx.istemplate \u003d \u0027y\u0027\n  ) \n",
      "user": "anonymous",
      "dateUpdated": "2025-05-30 08:56:40.836",
