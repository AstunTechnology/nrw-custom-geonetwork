    },
    {
      "text": "SELECT\r\n  mx.uuid AS \"NRW File identifier\",\r\n\r\n  -- INSPIRE Theme Keywords under descriptiveKeywords\r\n  array_to_string(\r\n    xpath(\r\n      \u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[gmd:type/gmd:MD_KeywordTypeCode[@codeListValue\u003d\"theme\"]\r\n         and\r\n         gmd:thesaurusName//gmx:Anchor[text()\u003d\"GEMET - INSPIRE themes, version 1.0\"]]/gmd:keyword/gmx:Anchor/text()\u0027::text,\r\n      mx.data_xml,\r\n      \u0027{{gmd,http://www.isotc211.org/2005/gmd},\r\n        {gmx,http://www.isotc211.org/2005/gmx},\r\n        {xlink,http://www.w3.org/1999/xlink}}\u0027::text[]\r\n    ),\r\n    \u0027, \u0027::text\r\n  ) AS \"INSPIRE Theme Keywords\",\r\n  -- Added in column to identify if they are relevant to MEDIN or data.gov as will be prioroty to fix before harvest \t\r\n\t(CASE\r\n\t        WHEN EXISTS (SELECT 1 FROM operationallowed oa WHERE oa.metadataid \u003d mx.id AND oa.groupid \u003d 102 AND oa.operationid \u003d 0) AND EXISTS (SELECT 1 FROM operationallowed oa2 WHERE oa2.metadataid \u003d mx.id AND oa2.groupid \u003d 103 AND oa2.operationid \u003d 0) THEN \u0027GEMINI \u0026 MEDIN\u0027\r\n\t        WHEN EXISTS (SELECT 1 FROM operationallowed oa WHERE oa.metadataid \u003d mx.id AND oa.groupid \u003d 102 AND oa.operationid \u003d 0) THEN \u0027GEMINI\u0027\r\n\t        WHEN EXISTS (SELECT 1 FROM operationallowed oa WHERE oa.metadataid \u003d mx.id AND oa.groupid \u003d 103 AND oa.operationid \u003d 0) THEN \u0027MEDIN\u0027\r\n\t        ELSE \u0027-\u0027\r\n\t    END \r\n\t) AS \"Groups Available in (GEMINI / MEDIN)\",\r\n\r\n  --I its an Anchor or CharacterString\r\n  CASE\r\n    WHEN xpath(\r\n      \u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[\r\n         gmd:type/gmd:MD_KeywordTypeCode[@codeListValue\u003d\"theme\"]\r\n         and\r\n         gmd:thesaurusName//gmx:Anchor[text()\u003d\"GEMET - INSPIRE themes, version 1.0\"]\r\n       ]/gmd:keyword/gmx:Anchor/text()\u0027::text,\r\n      mx.data_xml,\r\n      \u0027{{gmd,http://www.isotc211.org/2005/gmd},\r\n        {gco,http://www.isotc211.org/2005/gco},\r\n        {gmx,http://www.isotc211.org/2005/gmx},\r\n        {xlink,http://www.w3.org/1999/xlink}}\u0027::text[]\r\n    ) IS NOT NULL AND array_length(\r\n      xpath(\r\n        \u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[\r\n           gmd:type/gmd:MD_KeywordTypeCode[@codeListValue\u003d\"theme\"]\r\n           and\r\n           gmd:thesaurusName//gmx:Anchor[text()\u003d\"GEMET - INSPIRE themes, version 1.0\"]\r\n         ]/gmd:keyword/gmx:Anchor/text()\u0027::text,\r\n        mx.data_xml,\r\n        \u0027{{gmd,http://www.isotc211.org/2005/gmd},\r\n          {gco,http://www.isotc211.org/2005/gco},\r\n          {gmx,http://www.isotc211.org/2005/gmx},\r\n          {xlink,http://www.w3.org/1999/xlink}}\u0027::text[]\r\n      ), 1\r\n    ) \u003e 0\r\n    THEN \u0027Anchor\u0027\r\n    ELSE \u0027CharacterString\u0027\r\n  END AS \"Encoding Type\"\r\n\r\nFROM custom.metadata_xml mx\r\nWHERE (mx.istemplate \u003d \u0027n\u0027 OR mx.istemplate \u003d \u0027y\u0027)\r\n --enable the code below to select a specific reord only\r\n --AND mx.uuid \u003d \u0027${NRW File identifier}\u0027 \r\n\r\n\r\nLIMIT 4000;",
      "user": "anonymous",
      "dateUpdated": "2025-09-10 09:58:49.177",
      "progress": 0,
