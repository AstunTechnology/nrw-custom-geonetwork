    {
      "text": "SELECT\r\n  mx.uuid AS \"NRW File identifier\",\r\n\r\n  array_to_string(\r\n    xpath(\r\n      \u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[\r\n         gmd:type/gmd:MD_KeywordTypeCode[@codeListValue\u003d\"theme\"]\r\n         and\r\n         gmd:thesaurusName//gmx:Anchor[text()\u003d\"GEMET - INSPIRE themes, version 1.0\"]\r\n       ]/gmd:keyword/gco:CharacterString/text()\u0027::text,\r\n      mx.data_xml,\r\n      \u0027{{gmd,http://www.isotc211.org/2005/gmd},\r\n        {gco,http://www.isotc211.org/2005/gco},\r\n        {gmx,http://www.isotc211.org/2005/gmx}}\u0027::text[]\r\n    ),\r\n    \u0027, \u0027::text\r\n  ) AS \"Non-Anchored Theme Keywords\"\r\n\r\nFROM custom.metadata_xml mx\r\n\r\n-- Select only records where CharacterString keywords exist\r\nWHERE array_length(\r\n  xpath(\r\n    \u0027//gmd:descriptiveKeywords/gmd:MD_Keywords[\r\n       gmd:type/gmd:MD_KeywordTypeCode[@codeListValue\u003d\"theme\"]\r\n       and\r\n       gmd:thesaurusName//gmx:Anchor[text()\u003d\"GEMET - INSPIRE themes, version 1.0\"]\r\n     ]/gmd:keyword/gco:CharacterString\u0027::text,\r\n    mx.data_xml,\r\n    \u0027{{gmd,http://www.isotc211.org/2005/gmd},\r\n      {gco,http://www.isotc211.org/2005/gco},\r\n      {gmx,http://www.isotc211.org/2005/gmx}}\u0027::text[]\r\n  ),\r\n  1\r\n) \u003e 0\r\n\r\nLIMIT 4000;",
      "user": "anonymous",
      "dateUpdated": "2025-09-10 09:58:28.349",
