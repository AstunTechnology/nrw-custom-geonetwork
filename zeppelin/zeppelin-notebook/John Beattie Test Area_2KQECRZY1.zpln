    {
      "title": "Vertical Extent Keywords split with country",
      "text": "WITH extracted AS (\r\n  SELECT\r\n    mx.uuid,\r\n    (CASE\r\n\t        WHEN EXISTS (SELECT 1 FROM operationallowed oa WHERE oa.metadataid \u003d mx.id AND oa.groupid \u003d 102 AND oa.operationid \u003d 0) AND EXISTS (SELECT 1 FROM operationallowed oa2 WHERE oa2.metadataid \u003d mx.id AND oa2.groupid \u003d 103 AND oa2.operationid \u003d 0) THEN \u0027GEMINI \u0026 MEDIN\u0027\r\n\t        WHEN EXISTS (SELECT 1 FROM operationallowed oa WHERE oa.metadataid \u003d mx.id AND oa.groupid \u003d 102 AND oa.operationid \u003d 0) THEN \u0027GEMINI\u0027\r\n\t        WHEN EXISTS (SELECT 1 FROM operationallowed oa WHERE oa.metadataid \u003d mx.id AND oa.groupid \u003d 103 AND oa.operationid \u003d 0) THEN \u0027MEDIN\u0027\r\n\t        ELSE \u0027-\u0027\r\n\t    END \r\n\t) AS \"Groups Available in (GEMINI / MEDIN)\",\r\n\t\r\n    xpath(\r\n      \u0027//gmd:geographicElement/gmd:EX_GeographicDescription/\r\n       gmd:geographicIdentifier/gmd:MD_Identifier/gmd:code/gco:CharacterString/text()\u0027::text,\r\n      mx.data_xml,\r\n      \u0027{{gmd,http://www.isotc211.org/2005/gmd},\r\n        {gco,http://www.isotc211.org/2005/gco}}\u0027::text[]\r\n    ) AS code_values\r\n  FROM custom.metadata_xml mx\r\n  WHERE (mx.istemplate \u003d \u0027n\u0027 OR mx.istemplate \u003d \u0027y\u0027)\r\n)\r\nSELECT\r\n  uuid,\r\n  code_values[1]::text AS code_1,\r\n  code_values[2]::text AS code_2\r\nFROM extracted\r\nLIMIT 4000;",
      "user": "anonymous",
