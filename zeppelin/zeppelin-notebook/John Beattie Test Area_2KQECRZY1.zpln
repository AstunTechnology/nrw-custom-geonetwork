    {
      "title": "New Validations Report - What records are valid?",
      "text": "SELECT\r\n  mx.uuid AS URI,\r\n  array_to_string(\r\n    xpath(\r\n      \u0027/gmd:MD_Metadata/gmd:identificationInfo/gmd:MD_DataIdentification/gmd:citation/gmd:CI_Citation/gmd:title/gco:CharacterString/text()\u0027::text, \r\n      mx.data_xml, \r\n      \u0027{{gco,http://www.isotc211.org/2005/gco},{gmd,http://www.isotc211.org/2005/gmd}}\u0027::text[]\r\n    ), \r\n    \u0027-\u0027::text\r\n  ) AS \"Title\", \r\n  array_to_string(\r\n    xpath(\r\n      \u0027/gmd:MD_Metadata/gmd:identificationInfo/gmd:MD_DataIdentification/gmd:citation/gmd:CI_Citation/gmd:title/gmd:PT_FreeText//gmd:textGroup[2]/gmd:LocalisedCharacterString/text()\u0027 :: text, \r\n      mx.data_xml, \u0027{{gco,http://www.isotc211.org/2005/gco},{gmd,http://www.isotc211.org/2005/gmd}}\u0027 :: text[2]\r\n    ), \r\n    \u0027-\u0027 :: text\r\n  ) AS \"TitleCY\", \r\n  array_to_string(\r\n    xpath(\r\n      \u0027/gmd:MD_Metadata/gmd:identificationInfo/gmd:MD_DataIdentification/gmd:resourceConstraints[2]/gmd:MD_LegalConstraints/gmd:otherConstraints[2]/gco:CharacterString/text()\u0027 :: text, \r\n      mx.data_xml, \u0027{{gco,http://www.isotc211.org/2005/gco},{gmd,http://www.isotc211.org/2005/gmd},{nrw,http://naturalresources.wales/nrw}}\u0027 :: text[]\r\n    ), \r\n    \u0027-\u0027 :: text\r\n  ) AS \"Attribution Statement\",\t\r\n  array_to_string(\r\n  xpath(\r\n    \u0027//gmd:CI_ResponsibleParty[gmd:role/gmd:CI_RoleCode/@codeListValue\u003d\"custodian\"]/gmd:organisationName/gco:CharacterString/text()\u0027,\r\n    mx.data_xml,\r\n    \u0027{{gco,http://www.isotc211.org/2005/gco},{gmd,http://www.isotc211.org/2005/gmd}}\u0027::TEXT[]\r\n  ), \r\n  \u0027-\u0027::text\r\n) AS \"Custodian\",\r\n  array_to_string(\r\n    xpath(\r\n      \u0027/gmd:MD_Metadata/gmd:identificationInfo/gmd:MD_DataIdentification/gmd:resourceConstraints[2]/gmd:MD_LegalConstraints/gmd:otherConstraints[3]/gco:CharacterString/text()\u0027 :: text, \r\n      mx.data_xml, \u0027{{gco,http://www.isotc211.org/2005/gco},{gmd,http://www.isotc211.org/2005/gmd},{nrw,http://naturalresources.wales/nrw}}\u0027 :: text[]\r\n    ), \r\n    \u0027-\u0027 :: text\r\n  ) AS \"Attribution Statement2 - DELETE in Advanced View\",\t\r\n    array_to_string(\r\n    xpath(\r\n      \u0027/gmd:MD_Metadata/gmd:identificationInfo/gmd:MD_DataIdentification/gmd:resourceConstraints/gmd:MD_LegalConstraints[gmd:useConstraints]/gmd:otherConstraints/gmx:Anchor/text()\u0027 :: text, \r\n      mx.data_xml, \u0027{{gmx,http://www.isotc211.org/2005/gmx},{gmd,http://www.isotc211.org/2005/gmd}}\u0027 :: text[]\r\n    ), \r\n    \u0027-\u0027 :: text\r\n  ) AS \"Licence\",\r\n    array_to_string(\r\n    xpath(\r\n      \u0027/gmd:MD_Metadata/gmd:identificationInfo/gmd:MD_DataIdentification/gmd:resourceConstraints[2]/gmd:MD_LegalConstraints/gmd:otherConstraints[4]/gmx:Anchor/text()\u0027 :: text, \r\n      mx.data_xml, \u0027{{gmx,http://www.isotc211.org/2005/gmx},{gmd,http://www.isotc211.org/2005/gmd}}\u0027 :: text[]\r\n    ), \r\n    \u0027-\u0027 :: text\r\n  ) AS \"Licence2 - DELETE in Advanced View\",\r\n  (\r\n    CASE \r\n      WHEN EXISTS (\r\n        SELECT 1 \r\n        FROM validation \r\n        WHERE metadataid \u003d mx.id AND required \u003d \u0027true\u0027 AND failed !\u003d 0\r\n      ) THEN \u0027Invalid\u0027\r\n      WHEN EXISTS (\r\n        SELECT 1 \r\n        FROM validation \r\n        WHERE metadataid \u003d mx.id AND required \u003d \u0027true\u0027 AND failed \u003d 0\r\n      ) THEN \u0027Valid\u0027\r\n      ELSE \u0027Unassessed\u0027 \r\n    END\r\n  ) AS \"Validation Status\",\r\n  (\r\n    CASE \r\n      WHEN EXISTS (\r\n        SELECT 1 \r\n        FROM operationallowed oa \r\n        WHERE oa.metadataid \u003d mx.id AND oa.groupid \u003d 102 AND oa.operationid \u003d 0\r\n      ) \r\n      AND EXISTS (\r\n        SELECT 1 \r\n        FROM operationallowed oa2 \r\n        WHERE oa2.metadataid \u003d mx.id AND oa2.groupid \u003d 103 AND oa2.operationid \u003d 0\r\n      ) THEN \u0027GEMINI \u0026 MEDIN\u0027\r\n      WHEN EXISTS (\r\n        SELECT 1 \r\n        FROM operationallowed oa \r\n        WHERE oa.metadataid \u003d mx.id AND oa.groupid \u003d 102 AND oa.operationid \u003d 0\r\n      ) THEN \u0027GEMINI\u0027\r\n      WHEN EXISTS (\r\n        SELECT 1 \r\n        FROM operationallowed oa \r\n        WHERE oa.metadataid \u003d mx.id AND oa.groupid \u003d 103 AND oa.operationid \u003d 0\r\n      ) THEN \u0027MEDIN\u0027\r\n      ELSE \u0027-\u0027 \r\n    END\r\n  ) AS \"Groups Available in (GEMINI / MEDIN)\"\r\nFROM custom.metadata_xml mx\r\nWHERE mx.istemplate \u003d \u0027n\u0027 OR mx.istemplate \u003d \u0027y\u0027;",
      "user": "anonymous",
