xplanation gco:nilReason\u003d\"inapplicable\" /\u003e               \u003cgmd:pass\u003e                 \u003cgco:Boolean\u003efalse\u003c/gco:Boolean\u003e               \u003c/gmd:pass\u003e             \u003c/gmd:DQ_ConformanceResult\u003e           \u003c/gmd:result\u003e         \u003c/gmd:DQ_DomainConsistency\u003e       \u003c/gmd:report\u003e       \u003cgmd:lineage\u003e         \u003cgmd:LI_Lineage\u003e           \u003cgmd:statement xsi:type\u003d\"gmd:PT_FreeText_PropertyType\"\u003e             \u003cgco:CharacterString\u003eShows information about the National Trust owned land and properties across Wales and mid to south-west England.\u003c/gco:CharacterString\u003e             \u003cgmd:PT_FreeText\u003e               \u003cgmd:textGroup\u003e                 \u003cgmd:LocalisedCharacterString locale\u003d\"#EN\"\u003eShows information about the National Trust owned land and properties across Wales and mid to south-west England.\u003c/gmd:LocalisedCharacterString\u003e               \u003c/gmd:textGroup\u003e             \u003c/gmd:PT_FreeText\u003e           \u003c/gmd:statement\u003e         \u003c/gmd:LI_Lineage\u003e       \u003c/gmd:lineage\u003e     \u003c/gmd:DQ_DataQuality\u003e   \u003c/gmd:dataQualityInfo\u003e \u003c/gmd:MD_Metadata\u003e\tUnknown\tNon-editable\t2024-12-05T15:18:25.000Z\tAstun Technology Admin\t-\tPublic record\n"
