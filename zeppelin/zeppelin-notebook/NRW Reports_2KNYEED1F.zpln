{
  "paragraphs": [
    {
      "title": "NRW Report (including XML data column)",
      "text": "SELECT \n\tmx.id AS \"Database ID\",\n\tmx.uuid AS \"NRW File identifier\",\n    array_to_string(xpath(\u0027/gmd:MD_Metadata/gmd:identificationInfo/gmd:MD_DataIdentification/gmd:citation/gmd:CI_Citation/gmd:title/gco:CharacterString/text()\u0027::text, mx.data_xml, \u0027{{gco,http://www.isotc211.org/2005/gco},{gmd,http://www.isotc211.org/2005/gmd}}\u0027::text[]), \u0027-\u0027::text) AS \"Title\",\n\tarray_to_string(xpath(\u0027/gmd:MD_Metadata/gmd:fileIdentifier/gco:CharacterString/text()\u0027::text, mx.data_xml, \u0027{{gco,http://www.isotc211.org/2005/gco},{gmd,http://www.isotc211.org/2005/gmd}}\u0027::text[]), \u0027-\u0027::text) AS \"Resource Identifier\",\n\tarray_to_string(xpath(\u0027/gmd:MD_Metadata/gmd:contentInfo/nrw:MD_ContentInfo/nrw:internalInfo/nrw:MD_InternalInfo/nrw:internalLocationInfo/gco:CharacterString/text()\u0027::text, mx.data_xml, \u0027{{gco,http://www.isotc211.org/2005/gco},{gmd,http://www.isotc211.org/2005/gmd},{nrw,http://naturalresources.wales/nrw}}\u0027::text[]), \u0027-\u0027::text) AS \"NRW Internal Location\",\n\tarray_to_string(xpath(\u0027/gmd:MD_Metadata/gmd:contentInfo/nrw:MD_ContentInfo/nrw:internalInfo/nrw:MD_InternalInfo/nrw:internalContactInfo/gco:CharacterString/text()\u0027::text, mx.data_xml, \u0027{{gco,http://www.isotc211.org/2005/gco},{gmd,http://www.isotc211.org/2005/gmd},{nrw,http://naturalresources.wales/nrw}}\u0027::text[]), \u0027-\u0027::text) AS \"NRW Internal Custodian\",\n\tmx.data_xml AS \"XML Data\",\n\t(CASE\n\t        WHEN EXISTS (\n\t            SELECT 1\n\t            FROM validation\n\t            WHERE metadataid \u003d mx.id AND required \u003d \u0027true\u0027 AND failed !\u003d 0\n\t        ) THEN \u0027Invalid\u0027\n\t        WHEN EXISTS (\n\t            SELECT 1\n\t            FROM validation\n\t            WHERE metadataid \u003d mx.id AND required \u003d \u0027true\u0027 AND failed \u003d 0\n\t        ) THEN \u0027Valid\u0027\n\t        ELSE \u0027Unknown\u0027\n\t    END\n\t) AS \"Validation Status\",\n\t(CASE\n            WHEN mx.id IN (\n                SELECT metadataid\n                FROM operationallowed\n                WHERE operationid \u003d 2 AND groupid \u003d 107\n            ) THEN \u0027Editable\u0027\n            ELSE \u0027Non-editable\u0027\n        END\n    ) AS \"Edit Status\",\n\tms.changedate AS \"Date Last Edited\",\n    u.name || \u0027 \u0027 || u.surname AS \"Last Editor Name\",\n\t(CASE\n\t        WHEN EXISTS (SELECT 1 FROM operationallowed oa WHERE oa.metadataid \u003d mx.id AND oa.groupid \u003d 102 AND oa.operationid \u003d 0) AND EXISTS (SELECT 1 FROM operationallowed oa2 WHERE oa2.metadataid \u003d mx.id AND oa2.groupid \u003d 103 AND oa2.operationid \u003d 0) THEN \u0027GEMINI, MEDIN\u0027\n\t        WHEN EXISTS (SELECT 1 FROM operationallowed oa WHERE oa.metadataid \u003d mx.id AND oa.groupid \u003d 102 AND oa.operationid \u003d 0) THEN \u0027GEMINI\u0027\n\t        WHEN EXISTS (SELECT 1 FROM operationallowed oa WHERE oa.metadataid \u003d mx.id AND oa.groupid \u003d 103 AND oa.operationid \u003d 0) THEN \u0027MEDIN\u0027\n\t        ELSE \u0027-\u0027\n\t    END \n\t) AS \"Groups Available in (GEMINI, MEDIN)\",\n\t(CASE\n    \t    WHEN EXISTS (SELECT 1 FROM operationallowed oa WHERE oa.metadataid \u003d mx.id AND oa.groupid \u003d 1 AND oa.operationid \u003d 0) THEN \u0027Public record\u0027 \n    \t    ELSE \u0027Private record\u0027\n\t    END\n\t) AS \"Record in Public view\"\nFROM\n    custom.metadata_xml mx\nJOIN (\n    SELECT DISTINCT ON (uuid)\n        uuid,\n        changedate,\n        userid\n    FROM\n        metadatastatus\n    ORDER BY\n        uuid,\n        changedate DESC,\n        userid\n) ms ON mx.uuid \u003d ms.uuid\nJOIN\n    users u ON ms.userid \u003d u.id\nWHERE (mx.istemplate \u003d \u0027n\u0027 OR mx.istemplate \u003d \u0027y\u0027)\nLIMIT 5;",
      "user": "admin",
      "dateUpdated": "2025-02-25 15:58:28.908",
      "progress": 0,
