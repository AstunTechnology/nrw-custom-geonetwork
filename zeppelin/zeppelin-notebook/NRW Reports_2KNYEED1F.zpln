gmd:title\u003e                   \u003cgmd:date\u003e                     \u003cgmd:CI_Date\u003e                       \u003cgmd:date\u003e                         \u003cgco:Date\u003e2010-12-08\u003c/gco:Date\u003e                       \u003c/gmd:date\u003e                       \u003cgmd:dateType\u003e                         \u003cgmd:CI_DateTypeCode codeList\u003d\"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#CI_DateTypeCode\" codeListValue\u003d\"publication\" /\u003e                       \u003c/gmd:dateType\u003e                     \u003c/gmd:CI_Date\u003e                   \u003c/gmd:date\u003e                 \u003c/gmd:CI_Citation\u003e               \u003c/gmd:specification\u003e               \u003cgmd:explanation\u003e                 \u003cgco:CharacterString\u003eThis dataset has not been assessed for conformance to the referenced INSPIRE regulation.\u003c/gco:CharacterString\u003e               \u003c/gmd:explanation\u003e               \u003cgmd:pass\u003e                 \u003cgco:Boolean\u003efalse\u003c/gco:Boolean\u003e               \u003c/gmd:pass\u003e             \u003c/gmd:DQ_ConformanceResult\u003e           \u003c/gmd:result\u003e         \u003c/gmd:DQ_DomainConsistency\u003e       \u003c/gmd:report\u003e       \u003cgmd:lineage\u003e         \u003cgmd:LI_Lineage\u003e           \u003cgmd:statement xsi:type\u003d\"gmd:PT_FreeText_PropertyType\"\u003e             \u003cgco:CharacterString\u003eShows information about the National Trust owned land and properties across Wales and mid to south-west England.\u003c/gco:CharacterString\u003e             \u003cgmd:PT_FreeText\u003e               \u003cgmd:textGroup\u003e                 \u003cgmd:LocalisedCharacterString locale\u003d\"#EN\"\u003eShows information about the National Trust owned land and properties across Wales and mid to south-west England.\u003c/gmd:LocalisedCharacterString\u003e               \u003c/gmd:textGroup\u003e             \u003c/gmd:PT_FreeText\u003e           \u003c/gmd:statement\u003e         \u003c/gmd:LI_Lineage\u003e       \u003c/gmd:lineage\u003e     \u003c/gmd:DQ_DataQuality\u003e   \u003c/gmd:dataQualityInfo\u003e \u003c/gmd:MD_Metadata\u003e\tUnknown\tEditable\t2025-02-04T12:00:17.000Z\tAstun Technology Admin\t-\tPublic record\n"
