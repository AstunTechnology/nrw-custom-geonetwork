    <skos:prefLabel xml:lang="en">Zooplankton and zoobenthos morphological parameters</skos:prefLabel>
    <skos:broader rdf:resource="http://vocab.nerc.ac.uk/collection/L19/current/005/" />
    <skos:narrower rdf:resource="http://vocab.nerc.ac.uk/collection/P01/current/O32A9116/" />
    <skos:narrower rdf:resource="http://vocab.nerc.ac.uk/collection/P01/current/B843B52A/" />
    <skos:narrower rdf:resource="http://vocab.nerc.ac.uk/collection/P01/current/W6288604/" />
    <skos:definition xml:lang="en">Morphological parameters of zooplankton and zoobenthos (essentially any animal except for insects, earthworms or fish), such as size, shape and weight.  Benthic and planktonic animals have not been seggregated because there is a degree of overlap (eg shrimps).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocab.nerc.ac.uk/collection/P02/current/PHBI/">
    <skos:broader rdf:resource="http://vocab.nerc.ac.uk/collection/P22/current/18/" />
    <skos:notation>SDN:P02::PHBI</skos:notation>
    <skos:related rdf:resource="http://vocab.nerc.ac.uk/collection/P64/current/H028/" />
    <pav:hasVersion rdf:resource="http://vocab.nerc.ac.uk/collection/P02/current/PHBI/1/" />
    <skos:note xml:lang="en">accepted</skos:note>
    <pav:authoredOn>2010-01-27 14:18:10.0</pav:authoredOn>
    <skos:definition xml:lang="en">Concentration parameters for substances synthesised by man to modify bodily function or diagnose, cure, mitigate, treat, or prevent disease in either whole organisms or their constituent parts.</skos:definition>
    <dce:identifier>SDN:P02::PHBI</dce:identifier>
