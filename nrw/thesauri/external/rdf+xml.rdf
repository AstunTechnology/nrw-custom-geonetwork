    <skos:prefLabel xml:lang="en">Fish taxonomy-related abundance per unit area of the bed</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <pav:authoredOn>2017-07-17 12:08:43.0</pav:authoredOn>
    <skos:broader rdf:resource="http://vocab.nerc.ac.uk/collection/P05/current/002/" />
    <skos:inScheme rdf:resource="http://vocab.nerc.ac.uk/scheme/EDMED_DCAT_THEMES/current/" />
    <skos:broader rdf:resource="http://vocab.nerc.ac.uk/collection/P03/current/B020/" />
    <skos:note xml:lang="en">accepted</skos:note>
    <void:inDataset rdf:resource="http://vocab.nerc.ac.uk/.well-known/void" />
    <pav:version>2</pav:version>
    <skos:broader rdf:resource="http://vocab.nerc.ac.uk/collection/P22/current/32/" />
    <skos:definition xml:lang="en">Fish (Osteichthyes, Agnatha and Chondrichthyes) abundance per unit area of bed (sea, river, lake etc.) parameters presented at the level of taxa that may be mapped to entities in a standard taxonomy registry such as WoRMS or ITIS.  Includes animals normally considered as planktonic if they have been returned from sediment samples.</skos:definition>
    <owl:versionInfo>2</owl:versionInfo>
  </rdf:Description>
